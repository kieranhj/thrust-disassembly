.L394D
        RTS

.L394E
        LDX     #$01
        STX     level_var_E
        DEX
        STX     mission_complete_flag
        STX     L002B
        LDA     #$3C
        STA     L0044
        LDA     L005C
        STA     L0088
        LDA     L005D
        STA     L0089
        LDA     L005E
