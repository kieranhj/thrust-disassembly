        STX     mission_complete_flag
.L326F
        JMP     system_clock_fn

.L3272
        LDA     #$00
        STA     L0087
        BEQ     L327F

.player_entered_orbit_GUESS
        JSR     enter_orbit_sound

        LDA     #$FF
        STA     L0087
.L327F
        LDA     L0045
        PHA
        LDA     collision_flag
        PHA
        LDA     mission_complete_flag
        PHA
        LDX     #$FF
        STX     collision_flag
        INX
        STX     L0045
        STX     mission_complete_flag
        JSR     system_clock_fn

        JSR     L3184

        JSR     L2FF0

        JSR     L32D8

        LDA     L0072
        STA     L0080
        LDA     L0073
        STA     L0081
        LDA     L0074
        STA     L0084
        LDA     L008A
        STA     L0088
        LDA     L008B
        STA     L0089
        JSR     L2FF0

        JSR     L32D8

        LDA     L0072
        STA     L0082
        LDA     L0073
        STA     L0083
        LDA     L0074
        STA     L0085
        PLA
        PHA
        BNE     L32CB

        LDA     #$00
        STA     L0083
.L32CB
        JSR     L3235

