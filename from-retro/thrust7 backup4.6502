        EQUB    $00,$1E

.L3C78
        EQUB    $A5,$7E,$C9,$02,$90,$18,$C9,$07

\ ******************************************************************************
\ ******************************************************************************

.main_entry
        LDX     #$FF
        TXS								; reset stack
        LDX     #$A7
.zp_loop
        LDA     #$00
        STA     L0000,X
        DEX
        BNE     zp_loop					; reset first $A7 entries of zero page to 0

        LDY     #$4F					; size of multiplication table array (80)
        LDX     #$00
        LDA     #$00					; index into multiplication table arrays
        STA     value_low
        STA     value_high
.mult_by_8_loop							; create multiplication table N * 8 for 0 <= N <= $4F (79)
        LDA     value_low
        STA     mult_by_8_table_low,X	; store low byte at $9C0
        LDA     value_high
        STA     mult_by_8_table_high,X	; store high byte at $A10
        CLC
        LDA     value_low
        ADC     #$08
        STA     value_low
        LDA     value_high
        ADC     #$00
        STA     value_high				; add 8 to 16-bit number stored at $70
        INX
        DEY
        BPL     mult_by_8_loop			; loop 80 times

        LDA     WRCHV
        STA     old_wrchv
        LDA     WRCHV+1
        STA     old_wrchv+1				; store old WRCHV directly in code at jmp_wrchv
        LDA     #LO(main_wrchv)
        STA     WRCHV
        LDA     #HI(main_wrchv)
        STA     WRCHV+1					; redirect WRCHV to main_wrchv
		
\\ Copy OSWORD 7 (sound) parameters to $0700 (language space)
		
        LDX     #$00
.store_8_bytes_loop
        LDA     stored_at_07C8,X		
        STA     L07C8,X					; store 8 bytes at $07C8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07D0,X
        STA     L07D0,X					; store 8 bytes at $07D0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07D8,X
        STA     L07D8,X					; store 8 bytes at $07D8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07E0,X
        STA     L07E0,X					; store 8 bytes at $07E0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07E8,X
        STA     L07E8,X					; store 8 bytes at $07E8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07F0,X
        STA     L07F0,X					; store 8 bytes at $07F0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07F8,X
        STA     L07F8,X					; store 8 bytes at $07F8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07C0,X
        STA     L07C0,X					; store 8 bytes at $07C0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_0192,X
        STA     L0192,X					; store 8 bytes at $0192 **NEED TO FIND OUT WHAT'S HERE**
        INX
        CPX     #$08
        BNE     store_8_bytes_loop		; loop 8 times

\\ Store ballistics tables
		
        LDX     #$1F
.store_32_bytes_loop
        LDA     ballistics_table_1_relocated,X
        STA     ballistics_table_1,X	; store 32 bytes at $0880 **NEED TO FIND OUT WHAT'S HERE**
        LDA     ballistics_table_1a_relocated,X
        STA     ballistics_table_1a,X	; store 32 bytes at $08A0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     ballistics_table_2_relocated,X
        STA     ballistics_table_2,X	; store 32 bytes at $0980 **NEED TO FIND OUT WHAT'S HERE**
        LDA     ballistics_table_2a_relocated,X
        STA     ballistics_table_2a,X	; store 32 bytes at $09A0 **NEED TO FIND OUT WHAT'S HERE**
        DEX
        BPL     store_32_bytes_loop		; loop 32 times

\\ Relocate game entry code to $0400
		
        LDA     #LO(game_entry_relocated)
        STA     readptrB
        LDA     #HI(game_entry_relocated)
        STA     readptrB+1				; readptrB = $3DB3
        LDA     #LO(game_entry)
        STA     writeptrB
        LDA     #HI(game_entry)
        STA     writeptrB+1				; writeptrB = $0400
        LDY     #$00
        LDX     #$03					; copy 3 pages
.relocate_0400_loop
        LDA     (readptrB),Y
        STA     (writeptrB),Y
        INY
        BNE     relocate_0400_loop

        INC     readptrB+1
        INC     writeptrB+1
        DEX
        BNE     relocate_0400_loop		; copy 3 pages from $3DB3 to $0400

        LDA     #$08
        LDX     #$62
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E62

        LDA     #$08
        LDX     #$70
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E70

        LDA     #$08
        LDX     #$7D
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E7D

        LDA     #$08
        LDX     #$8B
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E8B

        LDX     #$00
.store_at_0100_loop
        LDA     high_score_table_relocated,X
        STA     high_score_table,X
        INX
        BPL     store_at_0100_loop		; store 128 bytes at $0100

        LDX     #$7D					; 126 bytes
.store_at_0900_loop
        LDA     in_game_messages_relocated,X
        STA     in_game_messages,X
        DEX
        BPL     store_at_0900_loop

        LDA     #$04
        STA     game_var_A

        LDA     #LO(mode_7_instructions)
        STA     readptrB
        LDA     #HI(mode_7_instructions)
        STA     readptrB+1				; set readptrB to mode_7_instructions

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait for vsync

        LDY     #$00
.write_chars_loop
        LDA     (readptrB),Y
        CMP     #$FF					; stop when hitting $FF
        BEQ     wait_for_spacebar

        JSR     jmp_wrchv				; write char

        INY
        BNE     write_chars_loop

        INC     L0081
        JMP     write_chars_loop		; write chars until reach $FF

.wait_for_spacebar
        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE					; *FX 15,0 - flush all buffers

        JSR     OSRDCH					; wait for keypress

        CMP     #ASCII_space			; 32 = space bar
        BNE     wait_for_spacebar		; wait until spacebar is pressed

        JMP     game_entry				; jump to game start at $0400

.game_entry_relocated					; actually executes at $0400 after relocation
        LDA     #LO(status_bar_bytes)
        STA     readptrB
        LDA     #HI(status_bar_bytes)
        STA     readptrB+1
        LDA     #LO($3C80)
        STA     writeptrB	
        LDA     #HI($3C80)
        STA     writeptrB+1

\\ No longer need main_entry code so can overwrite it
\\ This is copying 2 character rows of MODE 1 (status bar at top of screen)
\\ Can't see it because we're not in right mode yet
		
        LDY     #$00
        LDX     #$05					; copy 5 pages (1280 bytes) from $4212 over $3C80 (main_entry)
.copy_5_pages_loop
        LDA     (readptrB),Y
        STA     (writeptrB),Y
        INY
        BNE     copy_5_pages_loop

        INC     readptrB+1
        INC     writeptrB+1
        DEX
        BNE     copy_5_pages_loop

        JSR     clear_screen_and_init

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait vsync

        LDA     #$90
        JSR     OSBYTE					; *FX $90 - *TV - obtain interlace status

        TYA
        EOR     #$01					; invert interlace status
        AND     #$01					; keep only that bit
        STA     L04A8					; store at $04A8
        LDA     #$90
        JSR     OSBYTE					; *FX $90 - *TV

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait for vsync

        LDX     #$0D					; write R13-R0 to 6845
.set_crtc_reg_loop
        STX     LFE00					; store register number
        LDA     crtc_regs,X				; load crtc registers
        STA     LFE01					; store register value
        DEX
        BPL     set_crtc_reg_loop					;

        LDA     #$9A
        LDX     #$D8
        LDY     #$00
        JSR     OSBYTE					; *FX 154,216

        LDA     #$D8
        STA     LFE20					; write $D8 to R0 of ULA - **WHAT DOES THIS DO?**

        LDA     IRQ1V
        STA     old_irq1v
        LDA     IRQ1V+1
        STA     old_irq1v+1				; store IRQ1V

        SEI								; disable interrupts
        LDA     #LO(irq1_handler)
        STA     IRQ1V
        LDA     #HI(irq1_handler)
        STA     IRQ1V+1					; set IRQ1V to irq1_handler
        CLI								; enable interrupts

        LDA     #$18
        STA     LFE4E					; write $18 to system VIA - **WHY**
		
        LDX     #$00
.set_palette_loop
        LDA     palette_table,X			; load palette entry
        CMP     #$FF
        BEQ     done_set_palette_loop					; finish when reaching $FF

        STA     LFE21					; store palette register
        INX
        BNE     set_palette_loop		; loop

.done_set_palette_loop
        JSR     clear_screen_and_init
        JMP     game_start

\ ******************************************************************************
\ ******************************************************************************

.palette_table_relocated
        EQUB    $07,$17,$47,$57,$24,$34,$64,$74
        EQUB    $86,$96,$C6,$D6,$A5,$B5,$E5,$F5
        EQUB    $FF

.crtc_regs_relocated
		EQUB	$7F,$48,$5E,$28,$26,$00,$1E
        EQUB    $21,$01,$07,$67,$08,$07,$90,$FF

.envelope_1
        EQUB    $01,$02,$FB,$FD,$FB,$02,$03,$32
        EQUB    $7E,$F9,$F9,$F4,$7E,$00
.envelope_2
		EQUB	$02,$02
        EQUB    $FF,$00,$01,$09,$09,$09,$00,$00
        EQUB    $00,$01,$01
.envelope_3
		EQUB	$03,$04,$00,$00,$00
        EQUB    $01,$01,$01,$7E,$FC,$FE,$FC,$7E
        EQUB    $6E
.envelope_4
		EQUB	$04,$01,$FF,$FF,$FF,$12,$12
        EQUB    $12,$32,$F4,$F4,$F4,$6E,$46

.stored_at_07C8
        EQUB    $12,$00,$01,$00,$50,$00,$02,$00

.stored_at_07D0
        EQUB    $11,$00,$02,$00,$96,$00,$64,$00

.stored_at_07D8
        EQUB    $10,$00,$03,$00,$07,$00,$64,$00

.stored_at_07E0
        EQUB    $13,$00,$04,$00,$1E,$00,$14,$00

.stored_at_07E8
        EQUB    $02,$00,$F1,$FF,$BE,$00,$01,$00

.stored_at_07F0
        EQUB    $02,$00,$00,$00,$BE,$00,$02,$00

.stored_at_07F8
        EQUB    $10,$00,$F6,$FF,$05,$00,$03,$00

.stored_at_07C0
        EQUB    $02,$00,$F1,$FF,$96,$00,$01,$00

.stored_at_0192
        EQUB    $12,$00,$03,$00,$B9,$00,$01,$00

.high_score_table_relocated
        EQUB    $00,$00,$02,$20,$20,$20,$53,$50
        EQUB    $41,$43,$45,$4C,$4F,$52,$44,$20
        EQUB    $00,$50,$01,$20,$20,$20,$41,$44
        EQUB    $4D,$49,$52,$41,$4C,$20,$20,$20
        EQUB    $00,$00,$01,$20,$20,$20,$43,$4F
