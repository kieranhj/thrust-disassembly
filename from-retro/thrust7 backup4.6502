.game_start
		JMP		start_new_game

.game_var_A
        EQUB    $00						; game var? init to 1, incremented at start of levels 3-6 (not 1&2), capped at $23 (35)

.game_var_B_planet_destroyed
        EQUB    $00						; game var? init to 0, set to 8 when planet destroyed

.game_var_C_reverse_gravity
        EQUB    $00						; game var? init to 0 - related to reverse gravity flag

.game_var_D_invisible_landscape
        EQUB    $00						; game var? init to 0 - related to invisible landscape flag

.high_score_time_out
        EQUB    $00

.L35C6
        EQUB    $D9,$EB,$FD

\\ **NEEDS DISASSEMBLING**
.L35C9
		LDA		#$7E
		JSR		OSBYTE
		JSR		L3B37

.high_score_start
        LDA     #$7E
        JSR     OSBYTE					; clear escape + effects

        LDA     #$00
        STA     game_var_G
        STA     invisible_landscape_flag_GUESS
        STA     level_number_GUESS
        STA     reverse_gravity_flag_GUESS
        LDA     #$8C
        STA     high_score_time_out
        LDA     #$02
        STA     level_var_C
        JSR     L2BC6

        JSR     L2AD6

        JSR     object_var_init_GUESS
        JSR     object_logic_fn_A

        JSR     ship_logic_fn_A
        JSR     ship_logic_fn_B

        JSR     draw_object_X_0

        JSR     plot_high_score_table
        JSR     write_top_8_thrusters
        JSR     write_press_spacebar

        LDX     #$00
        STX     count_and_lookup_value
        STX     count_and_lookup_outer
        STX     count_and_lookup_index

.high_score_tick_loop
        INC     level_var_D
        JSR     draw_object_X_0

        JSR     L289E						; maybe draw or collision?

        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE						; *FX 15,0 - flush all buffers

        LDA     #$81
        LDX     #$03
        LDY     #$00
        JSR     OSBYTE						; *FX $81 - read key with time limit

        LDA     #$00
        STA     demo_mode
		
        LDX     #INKEY_spacebar
        JSR     test_keypress

        BEQ     start_new_game

        LDA     #$FF
        STA     demo_mode
		
        LDA     level_var_D
        AND     #$01
        BEQ     high_score_tick_loop

        DEC     high_score_time_out
        BNE     high_score_tick_loop

        JSR     clear_screen_and_init

        LDY     #$0A
        JSR     wait_time_out

        JMP     level_start_tick

.start_new_game
        LDX     #$01
        STX     game_var_A				; set game_var_A to 1
        DEX
        STX     game_var_B_planet_destroyed				; set game_var_B_planet_destroyed to 0
        STX     game_var_C_reverse_gravity				; set game_var_C_reverse_gravity to 0
        STX     game_var_D_invisible_landscape				; set game_var_D_invisible_landscape to 0
        STX     game_var_E				; set game_var_E to 0
        STX     game_var_F				; set game_var_F to 0

        LDX     #$03
.zero_4_bytes_loop
        LDA     #$00
        STA     fuel_A,X				; set fuel_A to zero
        STA     score,X					; set score to zero
        DEX
        BPL     zero_4_bytes_loop

        LDX     #$0D
.store_32_loop
        LDA     #$20
        STA     L0182,X					; store $20 (32) at L0183 for 13 bytes
        DEX
        BNE     store_32_loop

        LDA     #$00					; set initial score
        JSR     add_A_to_score

        LDA     #$04					; set initial number of lives
        STA     lives
        JSR     lose_a_life

        LDA     #$10
        STA     fuel_B					; set initial fuel value
		
        LDA     #$FF
        STA     game_var_G					; set game_var_G to 255 (-1)
		
        LDA     #$FF
        STA     level_number_GUESS		; set level_number_GUESS to 255 (-1)

        LDA     #$00
        STA     mission_number			; zero mission number
        STA     level_modifier_flag		; zero level modifier flag (reverse gravity etc.)
        STA     invisible_landscape_flag_GUESS					; set invisible_landscape_flag_GUESS to 0
        STA     reverse_gravity_flag_GUESS					; set reverse_gravity_flag_GUESS to 0
        STA     fuel_flag				; zero fuel flag
        JSR     plot_fuel_GUESS

.start_new_level
        LDA     #$00
        STA     level_var_A
        STA     level_var_B
        INC     game_var_G
        INC     level_number_GUESS
        LDA     level_number_GUESS
        CMP     #$06					; number of levels
        BNE     level_less_than_6

        LDA     #$00
        STA     level_number_GUESS		; reset level number to 0

        LDA     reverse_gravity_flag_GUESS
        EOR     #$FF
        STA     reverse_gravity_flag_GUESS				; invert game var I bits
        BNE     game_var_I_set

        LDA     invisible_landscape_flag_GUESS
        EOR     #$0F
        STA     invisible_landscape_flag_GUESS			; invert lower 4 bits of game var H

.game_var_I_set
        LDA     reverse_gravity_flag_GUESS
        BEQ     dont_write_reverse_gravity

        LDA     game_var_C_reverse_gravity
        BNE     dont_write_reverse_gravity

        JSR     clear_screen_and_init

        JSR     write_reverse_gravity

        LDY     #$96
        STY     game_var_C_reverse_gravity
        JSR     wait_time_out

        JMP     dont_write_invisible_landscape

.dont_write_reverse_gravity
        LDA     invisible_landscape_flag_GUESS
        BEQ     dont_write_invisible_landscape

        LDA     game_var_D_invisible_landscape
        BNE     dont_write_invisible_landscape

        JSR     clear_screen_and_init

        JSR     write_invisible_landscape

        LDY     #$96
        STY     game_var_D_invisible_landscape
        JSR     wait_time_out

.dont_write_invisible_landscape
        INC     game_var_F
        LDA     game_var_F
        AND     #$03
        BNE     level_less_than_6

        JSR     clear_screen_and_init

        LDX     game_var_E
        CPX     #$02
        BEQ     skip_inc_game_var_E

        INC     game_var_E
.skip_inc_game_var_E
        LDA     #$0A
        STA     L0081
        LDA     L35C6,X
        TAX
        JSR     plot_message_ext

        JSR     L2149					; something to do with plot_ship

        LDY     #$50
        JSR     wait_time_out

.level_less_than_6
        SED								; set decimal mode
        CLC
        LDA     mission_number
        ADC     #$01
        STA     mission_number			; increment mission_number by 1
        CLD								; clear decimal mode

        LDA     #$01
        LDX     mission_number
        CPX     #$03			
        BCC     mission_number_less_than_3					; mission_number less than 3

        INC     game_var_A				; increment game_var_A
        LDA     game_var_A
        CMP     #$23
        BCC     mission_number_less_than_3

        LDA     #$23
        STA     game_var_A				; cap game_var_A to $23 (35)
		
.mission_number_less_than_3
        CLC
        ADC     game_var_B_planet_destroyed				; game_var_A + game_var_B_planet_destroyed
        STA     level_var_C				; store at level_var_C
        LDA     #$00
        STA     game_var_B_planet_destroyed				; reset game_var_B_planet_destroyed to zero
        JSR     L2BC6

.leveL_retry
        JSR     L2AD6

.level_start_tick
        JSR     rnd
        AND     #$03
        ADC     #$08
        STA     level_var_random_A		; random level var

        JSR     rnd
        AND     #$03
        ADC     #$04
        STA     level_var_random_B		; random level var
		
        LDA     #$7F
        STA     level_var_random_C		; random level var

        JSR     rnd
        AND     #$03
        BNE     skip_level_var_random_C
        LDA     #$23
        STA     level_var_random_C		; is either $7F (75%) or $23 (25%)

.skip_level_var_random_C
        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE					; *FX 15,0 - flush all buffers

        LDA     #$00
        STA     level_var_D				; set level_var_D to 0

        JSR     object_var_init_GUESS

        JSR     object_logic_fn_A

        JSR     object_logic_fn_B

        JSR     ship_logic_fn_A

        JSR     draw_object_X_0

        LDY     #$08
        JSR     wait_time_out

.L37A0
        JSR     L3272
        L37A2   = L37A0+2

        LDA     #$00
        STA     level_var_E

        JSR     reset_system_clock

.tick_loop
        JSR     count_and_lookup_fn

        JSR     update_palette				; does palette mean what we think?

        JSR     ship_input_rotate

        JSR     level_logic_fn_GUESS

        JSR     object_logic_fn_A

        JSR     system_clock_fn

        JSR     L38B0						; something to do with palette again?

        JSR     draw_object_X_0

        JSR     ship_logic_fn_A

        JSR     L31D5						; probably ship logic also

        JSR     ship_input_fire

        JSR     L289E						; maybe draw or collision?

        JSR     L1D18

        JSR     object_logic_fn_B

        JSR     plot_fuel_GUESS

        JSR     update_sound_timer

        JSR     ship_input_thrust

        JSR     set_clear_carry_level_var_AB

        BCS     player_still_playing_GUESS

        LDA     L0044
        BPL     player_still_playing_GUESS

        LDY     #$03
        JSR     wait_time_out

        JSR     player_entered_orbit_GUESS

        LDY     #$14
        JSR     wait_time_out

        JSR     reset_palette_GUESS

        LDA     demo_mode
        BNE     go_to_high_score

        LDA     fuel_flag
        BNE     player_out_of_fuel

        LDA     mission_complete_flag
        BNE     player_completed_mission

        LDA     planet_destroyed_flag
        BMI     player_died_collision

.player_died_countdown
        JSR     clear_screen_and_init

        JSR     reset_palette_GUESS

        LDA     #$08
        STA     game_var_B_planet_destroyed
        JSR     write_planet_destroyed

        JSR     write_mission

        LDA     #$20
        JSR     plot_char

        LDA     mission_number
        JSR     print_decimal

        LDA     #$20
        JSR     plot_char

        JSR     plot_char

        JSR     write_failed

        JSR     write_no_bonus

        LDY     #$78
        JSR     wait_time_out

        JMP     start_new_level

.player_out_of_fuel
        JMP     game_over_GUESS

.go_to_high_score
        JMP     high_score_start

.player_died_collision
        JSR     clear_screen_and_init
        JSR     write_mission
        JSR     write_in
        JSR     write_complete

        LDY     #$3C
        JSR     wait_time_out

        JMP     leveL_retry

.player_completed_mission
        JSR     mission_complete

        JMP     start_new_level

.jump_tick_loop
        JMP     tick_loop

.player_still_playing_GUESS
        LDX     #INKEY_escape
        JSR     test_keypress

        BEQ     key_was_pressed

        LDA     demo_mode
        BEQ     skip_test_for_keypress

        LDA     #$81
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX $81 - read key with time limit

        CPY     #$FF
        BNE     key_was_pressed			; key was pressed

.skip_test_for_keypress
        INC     level_var_D
        LDA     L0043
        BEQ     jump_tick_loop

        LDA     demo_mode
        BNE     go_to_high_score

        LDA     fuel_flag
        BNE     game_over_GUESS

        JSR     lose_a_life

        CPX     #$FF
        BEQ     game_over_GUESS

        LDA     planet_destroyed_flag
        BMI     jump_to_retry_level

        JMP     player_died_countdown

.jump_to_retry_level
        JMP     leveL_retry

.game_over_GUESS
        JSR     clear_screen_and_init

        JSR     reset_palette_GUESS

        LDA     fuel_flag
        BEQ     skip_plot_message

        JSR     plot_message

.skip_plot_message
        JSR     write_game_over

        LDY     #$5A
        JSR     wait_time_out

        JMP     L35C9

.key_was_pressed
        JMP     high_score_start

.L38B0
        LDA     #$00
        STA     L0043
        LDA     mission_complete_flag
        BNE     L38BE

        LDA     L0018
        BNE     L38BE

        STA     L0045
.L38BE
        LDA     L0044
        BMI     L38F0

        LDA     planet_destroyed_flag
        BEQ     L38D1

        LDY     level_number_GUESS
        LDA     L2D34,Y
        LDY     #$02
        JSR     palette_set

.L38D1
        DEC     L0044
        BEQ     L3913

        LDA     L0044
        CMP     #$28
        BNE     L38E2

        LDA     #$00
        LDY     #$00
        JSR     palette_set

.L38E2
        DEC     L0054
        DEC     L0054
        BPL     L38F0

        LDA     L0042
        BMI     L3918

        LDA     mission_complete_flag
        BNE     L394E

.L38F0
        LDA     L0042
        BPL     L38FF

        LDA     mission_complete_flag
        BEQ     L38FF

        LDA     #$01
        STA     L0045
