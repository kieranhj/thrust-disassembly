        RTS

.explosion
        LDA     #$1F
        STA     sound_timer
        LDX     #$D0
        JSR     make_sound

        LDX     #$D8
        JMP     make_sound

.run_engine
        LDA     engine_sound_flag
        BNE     L3304

        LDA     #$05
        STA     engine_pitch_GUESS
.L32FB
        LDA     sound_timer
        BNE     L3304

        LDX     #$F8
        JSR     make_sound

.L3304
        LDA     #$02
        STA     engine_pitch_GUESS
        RTS

.own_gun_sound
        LDX     #$C8
        JMP     make_sound

.hostile_gun_sound
        LDX     #$E0
        JMP     make_sound

.collect_pod_fuel_sound
        LDX     #$E8
        JSR     make_sound

        LDX     #$F0
        JSR     make_sound

        LDX     #$E8
        JMP     make_sound

.make_sound
        LDY     #$07
.L3325
        LDA     L00A2
        BNE     sound_return

        LDA     demo_mode
        BNE     sound_return

        LDA     #$07
        JMP     OSWORD

.countdown_sound
        LDX     #$F0
        JSR     make_sound

        LDX     #$C0
        JMP     make_sound

.enter_orbit_sound
        LDX     #$92
        LDY     #$01
        JMP     L3325

.update_sound_timer
        LDA     sound_timer
        BEQ     sound_return

        DEC     sound_timer
		
.sound_return
        RTS

