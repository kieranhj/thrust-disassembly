.add_A_X_to_fuel						; add A to fuel_A, add X to fuel_B & fuel_C
        SED
        CLC
        ADC     fuel_A
        STA     fuel_A
        TXA
        ADC     fuel_B
        STA     fuel_B
        TXA
        ADC     fuel_C
        STA     fuel_C
        CLD
        ORA     fuel_B
        ORA     fuel_A
        BEQ     L1A3F

        LDA     #$00
        STA     fuel_variable
