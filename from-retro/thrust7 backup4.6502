        LDA     L0042
        BPL     L394D

        LDA     #$3C
        STA     L0044
        LDA     #$00
        STA     collision_flag
        LDA     #$01
        STA     L0042
        LDA     L0058
        STA     L0088
        CLC
        LDA     L0059
        ADC     #$04
        STA     L0089
        CLC
        LDA     L005A
