.plot_pod_sprite_GUESS
{
        LDA     #general_flag_E								; yes, this is immediate!
        STA     ship_fn_flag_addr_zp
        LDA     #$00
        STA     general_flag_E
        LDX     #$02
	.L2250
        LDA     ship_AND_pixel_mask_CODE,X
        STA     ship_fn_test_pixel_mask,X					; **MODIFIES CODE**
        DEX
        BPL     L2250

        LDA     #LO(ship_sprite_17_data)
        STA     L0074
        LDA     #HI(ship_sprite_17_data)
        STA     L0075
        LDA     general_flag_C
        BEQ     L227A

        LDA     #$00
        STA     general_flag_C
        LDA     L0079_old_plot_pod
        STA     L0077
        LDA     L007A_old_plot_pod
        STA     L0078
        LDA     L0076_old_shield_tractor_plot_pod
        STA     L0076
        LDX     #$03
        JSR     L21B6

	.L227A
        LDA     tractor_beam_pod_flag_UNKNOWN
        BNE     L2282

        JMP     return

	.L2282
        LDX     #$02
	.L2284
        LDA     ship_fn_SKIP_pixel_mask_CODE,X
        STA     ship_fn_test_pixel_mask,X							; **MODIFIES CODE**
        DEX
        BPL     L2284

        SEC
        LDA     ship_ypos_LO_GUESS
        SBC     pod_vector_y_LO_GUESS
        STA     plot_pod_L007B
        LDA     relative_ship_ypos_HI_GUESS
        SBC     pod_vector_y_HI_GUESS
        ROL     plot_pod_L007B
        ROL     A
        STA     plot_pod_L0072
        STA     pod_to_ship_vector_y_HI_GUESS
        SEC
        LDA     ship_xpos_SUB_GUESS
        SBC     pod_vector_x_SUB_GUESS
        LDA     ship_xpos_LO_GUESS
        SBC     pod_vector_x_LO_GUESS
        STA     pod_sprite_L0070
        STA     pod_to_ship_vector_x_LO_GUESS
        LDA     relative_ship_xpos_HI_GUESS
        SBC     pod_vector_x_HI_GUESS
        STA     plot_pod_L0071
        STA     pod_to_ship_vector_x_HI_GUESS
        LDX     #$03
        LDA     ship_has_pod_attached_GUESS
        BNE     L22BF

        LDA     #$00
        STA     general_flag_E
        RTS

	.L22BF
        LDA     #$01
        STA     general_flag_C
        JSR     plot_pod_line_GUESS

        LDA     L0079
        STA     L0079_old_plot_pod
        LDA     plot_pod_L007A
        STA     L007A_old_plot_pod
        LDA     L0076
        STA     L0076_old_shield_tractor_plot_pod

	.return
        RTS
}

