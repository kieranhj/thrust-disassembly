\ ******************************************************************************

.palette_set_colour_Y_to_A
{
        ORA     palette_base_mask,Y
        EOR     #$07
        STA     SHEILA_Palette
        ORA     #$10
        STA     SHEILA_Palette
        ORA     #$40
        STA     SHEILA_Palette
        EOR     #$10
        STA     SHEILA_Palette
        RTS
}

.palette_base_mask
        EQUB    $00,$20,$80,$A0

