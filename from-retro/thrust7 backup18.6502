        LDA     L0078
        ADC     #$02							; character row = $240 bytes -> $239 = $240 - 7
        STA     L0078
.load_from_addr_3
        LDA     LFFFF,X							; **SELF-MODIFIED CODE**
        load_addr_3_LO   = load_from_addr_3+1
        load_addr_3_HI   = load_from_addr_3+2
        CMP     #$80
        BNE     L21DE

        JMP     L21D4

	.L2231
        RTS
\\ }

.set_ship_fn_pixel_mask_addr
{
        LDA     pixel_mask_ptrs_LO-1,X	; presume X>0
        STA     ship_fn_pixel_mask_addr_LO					; **MODIFIES CODE**
        LDA     pixel_mask_ptrs_HI-1,X
        STA     ship_fn_pixel_mask_addr_HI					; **MODIFIES CODE**
        RTS
}

.pixel_mask_ptrs_LO
        EQUB    LO(pixel_masks_3)
		EQUB	LO(pixel_masks_2)
        EQUB    LO(pixel_masks_1)

.pixel_mask_ptrs_HI
		EQUB	HI(pixel_masks_3)
		EQUB	HI(pixel_masks_2)
		EQUB	HI(pixel_masks_1)

