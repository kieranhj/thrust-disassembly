        LDA     L0075
        STA     load_addr_1_HI					; **MODIFIES CODE**
        STA     load_addr_2_HI					; **MODIFIES CODE**
        STA     load_addr_3_HI					; **MODIFIES CODE**
        LDX     #$00
        JMP     L21D7

.L21D4
        LDX     L0073
        INX
.L21D7
        STX     L0073
.load_from_addr_1
        LDA     LFFFF,X					; **SELF-MODIFIED CODE**
        load_addr_1_LO   = load_from_addr_1+1
