.ship_fn_test_pixel_mask
        AND     pixel_masks_1,X			; **SELF-MODIFIED CODE**
        BEQ     L21D4

        LDA     #$FF
.ship_fn_store_flag
        STA     general_flag_E			; **SELF-MODIFIED CODE**
