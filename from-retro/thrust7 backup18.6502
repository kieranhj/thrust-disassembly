\ ******************************************************************************

.level_obj_pos_X_lookup_LO
		EQUB	LO(level_0_obj_pos_X)
.level_obj_pos_X_lookup_HI
		EQUB	HI(level_0_obj_pos_X)
		EQUB	LO(level_1_obj_pos_X), HI(level_1_obj_pos_X)
		EQUB	LO(level_2_obj_pos_X), HI(level_2_obj_pos_X)
		EQUB	LO(level_3_obj_pos_X), HI(level_3_obj_pos_X)
		EQUB	LO(level_4_obj_pos_X), HI(level_4_obj_pos_X)
		EQUB	LO(level_5_obj_pos_X), HI(level_5_obj_pos_X)

.level_obj_pos_Y_lookup_LO
		EQUB	LO(level_0_obj_pos_Y)
.level_obj_pos_Y_lookup_HI
		EQUB	HI(level_0_obj_pos_Y)
		EQUB	LO(level_1_obj_pos_Y), HI(level_1_obj_pos_Y)
		EQUB	LO(level_2_obj_pos_Y), HI(level_2_obj_pos_Y)
		EQUB	LO(level_3_obj_pos_Y), HI(level_3_obj_pos_Y)
		EQUB	LO(level_4_obj_pos_Y), HI(level_4_obj_pos_Y)
		EQUB	LO(level_5_obj_pos_Y), HI(level_5_obj_pos_Y)

.level_obj_pos_Y_EXT_lookup_LO
		EQUB	LO(level_0_obj_pos_Y_EXT)
.level_obj_pos_Y_EXT_lookup_HI
		EQUB	HI(level_0_obj_pos_Y_EXT)
		EQUB	LO(level_1_obj_pos_Y_EXT), HI(level_1_obj_pos_Y_EXT)
		EQUB	LO(level_2_obj_pos_Y_EXT), HI(level_2_obj_pos_Y_EXT)
		EQUB	LO(level_3_obj_pos_Y_EXT), HI(level_3_obj_pos_Y_EXT)
		EQUB	LO(level_4_obj_pos_Y_EXT), HI(level_4_obj_pos_Y_EXT)
		EQUB	LO(level_5_obj_pos_Y_EXT), HI(level_5_obj_pos_Y_EXT)

.level_obj_type_lookup_LO
		EQUB	LO(level_0_obj_type)
.level_obj_type_lookup_HI
		EQUB	HI(level_0_obj_type)
		EQUB	LO(level_1_obj_type), HI(level_1_obj_type)
		EQUB	LO(level_2_obj_type), HI(level_2_obj_type)
		EQUB	LO(level_3_obj_type), HI(level_3_obj_type)
		EQUB	LO(level_4_obj_type), HI(level_4_obj_type)
		EQUB	LO(level_5_obj_type), HI(level_5_obj_type)

.level_gun_param_lookup_LO
		EQUB	LO(level_0_gun_param)
.level_gun_param_lookup_HI
		EQUB	HI(level_0_gun_param)
		EQUB	LO(level_1_gun_param), HI(level_1_gun_param)
		EQUB	LO(level_2_gun_param), HI(level_2_gun_param)
		EQUB	LO(level_3_gun_param), HI(level_3_gun_param)
		EQUB	LO(level_4_gun_param), HI(level_4_gun_param)
		EQUB	LO(level_5_gun_param), HI(level_5_gun_param)

\ ******************************************************************************
\ ******************************************************************************

.ship_input_fire
{
        LDA     planet_exploding_state_GUESS
        BPL     fire_return

        LDA     shield_tractor_pressed
        BEQ     test_fire_key

        LDA     #$FF
        STA     player_pressed_fire

	.fire_return
        RTS
}

.test_fire_key
{
        LDX     #INKEY_return
        JSR     test_inkey

        CPX     #$FF
        BEQ     fire_pressed

        LDA     #$00
        STA     player_pressed_fire
        RTS

	.fire_pressed
        LDA     player_pressed_fire
        BEQ     player_shoot_bullet		; don't shoot another bullet if fire button already pressed
        RTS

	.player_shoot_bullet
        LDX     bullet_index		; guess this is number bullets active (or some sort of bullet stack)
        LDA     particles_type,X					; guess we're checking whether there is a free bullet slot
        CMP     #$00
        BNE     create_new_player_bullet					; don't fire unless not equal to 0

        LDA     particles_lifetime,X					; ditto checking whether there's a free bullet slot
        BEQ     create_new_player_bullet					; don't fire unless equal to 0

        RTS
}

.angle_to_bullet_dx_dy
{
        LDA     angle_to_X_low,Y		; guess this converts the rotation angle to X,Y (LO,HI)
        STA     particles_dx_low,X	; guess these are bullet direction X,Y (LO,HI)
        LDA     angle_to_X_high,Y
        STA     particles_dx_high,X
        LDA     angle_to_Y_low,Y
        STA     particles_dy_low,X
        LDA     angle_to_Y_high,Y
        STA     particles_dy_high,X
        RTS
}

.create_new_player_bullet
{
        LDA     #$FF
        STA     player_pressed_fire

        LDA     player_xpos_LO_GUESS
        STA     particles_xpos_low,X
        LDA     player_xpos_HI_GUESS
        CLC
        ADC     #$04					; player x position offset by $4 - start bullet in centre?
        STA     particles_xpos_high,X
        LDA     player_ypos_LO_GUESS
        STA     particles_ypos_low,X
        CLC
        LDA     player_ypos_HI_GUESS
        ADC     #$05					; player y position offset by $5 - start bullet in centre?
        STA     particles_ypos_high,X
        LDA     player_ypos_EXT_GUESS
        ADC     #$00
        STA     particles_ypos_ext_GUESS,X
		
        LDY     ship_angle
        JSR     angle_to_bullet_dx_dy

        LDY     #$02
	.move_bullet_initial
        CLC
        LDA     particles_xpos_low,X
        ADC     particles_dx_low,X
        STA     particles_xpos_low,X
        LDA     particles_xpos_high,X
        ADC     particles_dx_high,X
        STA     particles_xpos_high,X
        CLC
        LDA     particles_ypos_low,X
        ADC     particles_dy_low,X
        STA     particles_ypos_low,X
        LDA     particles_ypos_high,X
        ADC     particles_dy_high,X
        STA     particles_ypos_high,X
        PHP
        LDA     particles_dy_high,X
        BMI     bullet_dy_negative

        LDA     #$00
        JMP     bullet_dy_positive

	.bullet_dy_negative
        LDA     #$FF
		
	.bullet_dy_positive
        PLP
        ADC     particles_ypos_ext_GUESS,X
        STA     particles_ypos_ext_GUESS,X
        DEY
        BNE     move_bullet_initial

        CLC
        LDA     particles_dx_low,X
        ADC     player_velocity_x_low_GUESS
        STA     particles_dx_low,X
        LDA     particles_dx_high,X
        ADC     player_velocity_x_high_GUESS
        STA     particles_dx_high,X
        CLC
        LDA     particles_dy_low,X
        ADC     player_velocity_y_low_GUESS
        STA     particles_dy_low,X
        LDA     particles_dy_high,X
        ADC     player_velocity_y_high_GUESS
        STA     particles_dy_high,X

        LDA     particles_lifetime,X
        AND     #PARTICLE_flag
        ORA     #PARTICLE_lifetime_bullet
        STA     particles_lifetime,X

        LDA     #PARTICLE_type_player_bullet
        STA     particles_type,X

        INX
        TXA
        AND     #$03					; can only have 4 active bullets
        TAX
        STX     bullet_index
        JSR     own_gun_sound

        RTS
}

\ ******************************************************************************
\ ******************************************************************************

\\ Appears to be unreachable code?
{		
        LDA     #$28
        STA     particles_xpos_low,X
        STA     particles_xpos_high,X
        LDA     #$02
        STA     particles_ypos_low,X
        STA     particles_ypos_high,X
        STA     particles_ypos_ext_GUESS,X
        LDA     #$01
        STA     particles_dx_low,X
        STA     particles_dx_high,X
        STA     particles_dy_low,X
        STA     particles_dy_high,X
        LDA     #$28
        STA     particles_lifetime,X
        LDA     #$00
        STA     particles_type,X
        RTS
}

\ ******************************************************************************
\ * Random number generator - returns a random byte in A with workspace $3A, 3B
\ ******************************************************************************

.rnd
{
        PHP
        LDA     rnd_A
        PHA
        LDA     rnd_B
        PHA
        LDA     rnd_A
        PHA
        CLC
        ROL     A
        ROL     rnd_B
        ROL     A
        ROL     rnd_B
        ORA     #$01
        STA     rnd_A
        CLC
        PLA
        ADC     rnd_A
        STA     rnd_A
        PLA
        ADC     rnd_B
        STA     rnd_B
        PLA
        CLC
        ADC     rnd_B
        STA     rnd_B
        EOR     rnd_A
        PLP
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.do_tractor_beam_GUESS_UNKNOWN_FN
\\ {
        SEC
        LDA     relative_pod_ypos_HI_GUESS
        SBC     pod_to_ship_vector_y_HI_GUESS
        BCS     L2EE7

        EOR     #$FF
        CLC
        ADC     #$01
	.L2EE7
        STA     tractor_beam_L0089
        LDA     pod_xpos_LO_GUESS
        SEC
        SBC     pod_to_ship_vector_x_LO_GUESS
        STA     L0072
        LDA     relative_pod_xpos_HI_GUESS
        SBC     pod_to_ship_vector_x_HI_GUESS
        BVS     L2F2C

        TAY
        AND     #$E0
        BEQ     L2EFF

        CMP     #$E0
        BNE     L2F2C

	.L2EFF
        TYA
        ROL     L0072
        ROL     A
        ROL     L0072
        ROL     A
        BPL     L2F0D

        EOR     #$FF
        CLC
        ADC     #$01
	.L2F0D
        STA     tractor_beam_L0088

.L2F0F
        LDA     tractor_beam_L0088
        CMP     tractor_beam_L0089
        BCS     L2F1B

        LDY     tractor_beam_L0089
        STA     tractor_beam_L0089
        STY     tractor_beam_L0088
	.L2F1B
        LDA     tractor_beam_L0089
        CLC
        ADC     tractor_beam_L0088
        BCS     L2F2C

        ADC     tractor_beam_L0088
        BCS     L2F2C

        ADC     tractor_beam_L0088
        BCS     L2F2C

        BCC     L2F2E

	.L2F2C
        LDA     #$FF
	.L2F2E
        RTS
\\ }

\ ******************************************************************************
\ ******************************************************************************

.old_jmp_fn_LO
        EQUB    $00
.old_jmp_fn_HI
        EQUB    $00

\ ******************************************************************************
\ * L008A, L008B, L0088, L0089
\ ******************************************************************************

.unknown_function_fiddles_with_jump_code
{
        SEC
        LDA     jump_code_L008A
        SBC     jump_code_L0088
        BCS     L2F52

        EOR     #$FF
        ADC     #$01
        PHA
        LDA     jump_code_L0088
        PHA
        LDA     jump_code_L008A
        STA     jump_code_L0088
        PLA
        STA     jump_code_L008A
        LDA     jump_code_L0089
        PHA
        LDA     jump_code_L008B
        STA     jump_code_L0089
        PLA
        STA     jump_code_L008B
        PLA
	.L2F52
        STA     unknown_jump_L0070
        STA     L0075
        LDA     #LO(unknown_increment_ptr_AND_7)
        STA     old_jmp_fn_LO						; **MODIFIES CODE**
        LDA     #HI(unknown_increment_ptr_AND_7)
        STA     old_jmp_fn_HI						; **MODIFIES CODE**
