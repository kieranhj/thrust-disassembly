\ ******************************************************************************
\ * Character plot routines
\ ******************************************************************************
		
.char_write_ptr_next_column
{
        CLC
        LDA     char_write_ptr_LO
        ADC     #$08
        STA     char_write_ptr_LO
        BCC     return

        INC     char_write_ptr_HI
	.return
        RTS
}

.char_clear_cursor_backspace
{
        LDA     #$00
        LDY     #$04
        STA     (char_write_ptr_LO),Y
        LDY     #$0C
        STA     (char_write_ptr_LO),Y
        SEC
        LDA     char_write_ptr_LO
        SBC     #$10
        STA     char_write_ptr_LO
        BCS     return

        DEC     char_write_ptr_HI
	.return
        RTS
}

.char_plot_cursor
{
        LDA     char_flag_cursor
        BEQ     skip_strikethrough

        LDA     #$0F
        LDY     #$04
        STA     (char_write_ptr_LO),Y
        LDY     #$0C
        STA     (char_write_ptr_LO),Y

	.skip_strikethrough
        PLA
        TAY
        PLA
        TAX
        PLA
        CLC
        RTS
}

.plot_char_A
{
        STA     char_to_plot
        PHA
        TXA
        PHA
        TYA
        PHA
        LDA     char_to_plot
        CMP     #ASCII_beep
        BEQ     plot_char_beep

        CMP     #ASCII_space
        BCC     char_plot_cursor

        BEQ     plot_char_space

        CMP     #ASCII_delete
        BEQ     plot_char_delete

        CMP     #ASCII_0
        BCC     not_a_number

        CMP     #ASCII_9+1
        BCC     plot_ascii_number

	.not_a_number
        ORA     #$20
        CMP     #ASCII_a
        BCC     not_a_letter

        CMP     #ASCII_z+1
        BCC     plot_ascii_lower_case_letter

	.not_a_letter
        LDA     #$00
        JMP     plot_font_A

	.plot_char_space
        JSR     char_erase
        JMP     char_plot_cursor

	.plot_char_beep
        JSR     jmp_wrchv
        JMP     char_plot_cursor
}

.char_erase
{
        LDX     #$02
	.col_loop
        LDY     #$04
        LDA     #$00
	.row_loop
        STA     (char_write_ptr_LO),Y
        DEY
        BPL     row_loop

        JSR     char_write_ptr_next_column

        DEX
        BNE     col_loop

        RTS
}

.plot_char_delete
{
        JSR     char_clear_cursor_backspace
        JSR     char_erase
        JSR     char_clear_cursor_backspace
        JMP     char_plot_cursor
}

.plot_ascii_lower_case_letter
{
        SEC
        SBC     #$60
        JMP     plot_font_A
}

.plot_ascii_number
{
        SEC
        SBC     #$15
        JMP     plot_font_A
}

.plot_font_A
{
        TAX
        LDY     #$00
        LDA     font_data_line_0,X
        JSR     plot_font_top_nibble

        LDA     font_data_line_1,X
        JSR     plot_font_top_nibble

        LDA     font_data_line_2,X
        JSR     plot_font_top_nibble

        LDA     font_data_line_3,X
        JSR     plot_font_top_nibble

        LDA     font_data_line_4,X
        JSR     plot_font_top_nibble

        JSR     char_write_ptr_next_column

        LDY     #$00
        LDA     font_data_line_0,X
        JSR     plot_font_bottom_nibble

        LDA     font_data_line_1,X
        JSR     plot_font_bottom_nibble

        LDA     font_data_line_2,X
        JSR     plot_font_bottom_nibble

        LDA     font_data_line_3,X
        JSR     plot_font_bottom_nibble

        LDA     font_data_line_4,X
        JSR     plot_font_bottom_nibble

        JSR     char_write_ptr_next_column
        JMP     char_plot_cursor
}

.char_to_plot
        EQUB    $00

.char_flag_cursor
        EQUB    $00

.plot_font_top_nibble
\\ {
        PHA
        AND     #$F0
        STA     char_to_plot
        PLA
        ROR     A
        ROR     A
        ROR     A
        ROR     A
        AND     #$0F
        ORA     char_to_plot
.plot_font_byte
        AND     font_byte_mask
        STA     (char_write_ptr_LO),Y
        INY
        RTS
\\ }

.plot_font_bottom_nibble
{
        PHA
        AND     #$0F
        STA     char_to_plot
        PLA
        ROL     A
        ROL     A
        ROL     A
        ROL     A
        AND     #$F0
        ORA     char_to_plot
        JMP     plot_font_byte
}

\ ******************************************************************************
\ ******************************************************************************

.tractor_beam_fn_UNKNOWN
{
        STA     tractor_beam_L008B
        LDA     #$00
        STA     tractor_beam_L0089
        STA     tractor_beam_L008A
        STA     tractor_beam_L008C
        LDA     tractor_beam_L0088
        BPL     L16F2

        EOR     #$FF
        STA     tractor_beam_L0088
        INC     tractor_beam_L0088
        LDA     tractor_beam_L008B
        EOR     #$FF
        STA     tractor_beam_L008B
        INC     tractor_beam_L008B
	.L16F2
        LDA     tractor_beam_L008B
        BPL     L16FA

        LDA     #$FF
        STA     tractor_beam_L008C
	.L16FA
        LDX     #$08
	.L16FC
        ROR     tractor_beam_L0088
        BCC     L170D

        LDA     tractor_beam_L008B
        CLC
        ADC     tractor_beam_L0089
        STA     tractor_beam_L0089
        LDA     tractor_beam_L008C
        ADC     tractor_beam_L008A
        STA     tractor_beam_L008A
	.L170D
        CLC
        ROL     tractor_beam_L008B
        ROL     tractor_beam_L008C
        DEX
        BNE     L16FC

        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.update_window_GUESS
{
        CLC
        LDA     window_var_unknown
        ADC     window_xpos_HI_GUESS
        STA     window_xpos_HI_GUESS
        CLC
        LDA     general_var_B_HI
        BMI     L173B

        BEQ     L174F

        ADC     window_ypos_HI_GUESS
        STA     window_ypos_HI_GUESS
        BCC     L172C

        INC     window_ypos_EXT_GUESS
	.L172C
        LDA     general_var_B_HI
	.L172E
        PHA
        JSR     terrain_process_accumulate_xpos			; increments terrain_window_y_index

        PLA
        SEC
        SBC     #$01
        BNE     L172E

        JMP     L174F

	.L173B
        ADC     window_ypos_HI_GUESS
        STA     window_ypos_HI_GUESS
        BCS     L1743

        DEC     window_ypos_EXT_GUESS
	.L1743
        LDA     general_var_B_HI
	.L1745
        PHA
        JSR     terrain_process_subtract_xpos			; decrements terrain_window_y_index

        PLA
        CLC
        ADC     #$01
        BNE     L1745

	.L174F
        JSR     tick_door_logic

        SEC
        LDA     ship_ypos_HI_GUESS
        SBC     window_ypos_HI_GUESS
        SEC
        SBC     #$38
        STA     relative_ship_ypos_HI_GUESS
        SEC
        LDA     ship_force_y_HI
        BMI     L1785

        LDA     relative_ship_ypos_HI_GUESS
        CMP     #$5D
        BCS     L177D

        LDA     general_var_B_HI
        BMI     L177A

        BEQ     L177A

        LDX     ship_force_y_HI
        INX
        CPX     general_var_B_HI
        BCS     L177A

        DEC     general_var_B_HI
        BNE     L177A

        INC     general_var_B_HI
	.L177A
        JMP     L17A3

	.L177D
        LDX     ship_force_y_HI
        INX
        STX     general_var_B_HI
        JMP     L17A3

	.L1785
        LDA     relative_ship_ypos_HI_GUESS
        CMP     #$2F
        BCC     L179E

        LDA     general_var_B_HI
        BPL     L179B

        LDA     general_var_B_HI
        CMP     ship_force_y_HI
        BCS     L179B

        INC     general_var_B_HI
        BNE     L179B

        DEC     general_var_B_HI
	.L179B
        JMP     L17A3

	.L179E
        LDX     ship_force_y_HI
        DEX
        STX     general_var_B_HI
	.L17A3
        LDA     general_var_B_HI
        BEQ     L17C0

        BMI     L17B6

        LDA     relative_ship_ypos_HI_GUESS
        CMP     #$3C
        BCS     L17C0

        LDA     #$00
        STA     general_var_B_HI
        JMP     L17C0

	.L17B6
        LDA     relative_ship_ypos_HI_GUESS
        CMP     #$50
        BCC     L17C0

        LDA     #$00
        STA     general_var_B_HI
	.L17C0
        SEC
        LDA     ship_xpos_HI_GUESS
        SBC     window_xpos_HI_GUESS
        STA     relative_ship_xpos_HI_GUESS
        SEC
        SBC     #$10
        BCS     L17D1

        STA     window_var_unknown
        JMP     L17DC

	.L17D1
        LDA     relative_ship_xpos_HI_GUESS
        SEC
        SBC     #$30
        BEQ     L17DC

        BCC     L17DC

        STA     window_var_unknown
	.L17DC
        LDA     window_var_unknown
        BEQ     L1813

        BMI     L17FC

        LDA     relative_ship_xpos_HI_GUESS
        CMP     #$1D
        BCS     L17EF

        LDA     #$00
        STA     window_var_unknown
        JMP     L1813

	.L17EF
        CMP     #$30
        BCS     L1813

        DEC     window_var_unknown
        BNE     L1813

        INC     window_var_unknown
        JMP     L1813

	.L17FC
        LDA     relative_ship_xpos_HI_GUESS
        CMP     #$23
        BCC     L1809

        LDA     #$00
        STA     window_var_unknown
        JMP     L1813

	.L1809
        CMP     #$10
        BCC     L1813

        INC     window_var_unknown
        BNE     L1813

        DEC     window_var_unknown
	.L1813
        LDA     window_xpos_HI_GUESS
        BEQ     L181B

        CMP     #$DC
        BCC     L181F

	.L181B
        LDA     #$B7
        BNE     L1825

	.L181F
        CMP     #$B8
        BCC     L187E

        LDA     #$49
	.L1825
        STA     update_window_L0080
        LDA     window_xpos_HI_GUESS
        CLC
        ADC     update_window_L0080
        STA     window_xpos_HI_GUESS
        LDA     ship_xpos_HI_GUESS
        CLC
        ADC     update_window_L0080
        STA     ship_xpos_HI_GUESS
        LDA     player_xpos_HI_GUESS
        CLC
        ADC     update_window_L0080
        STA     player_xpos_HI_GUESS
        LDA     old_player_xpos_HI_GUESS
        CLC
        ADC     update_window_L0080
        STA     old_player_xpos_HI_GUESS
        LDX     #$1F
	.L1845
        LDA     particles_xpos_high,X
        CLC
        ADC     update_window_L0080
        STA     particles_xpos_high,X
        DEX
        BPL     L1845

        LDX     #$11
	.L1853
        LDA     terrain_draw_table_3,X
        BNE     L1868

        LDA     terrain_draw_table_1,X
        BNE     L187B

        LDA     #$48
        STA     terrain_draw_table_1,X
        STA     terrain_draw_table_3,X
        JMP     L187B

	.L1868
        CMP     #$48
        BNE     L187B

        LDA     terrain_draw_table_1,X
        CMP     #$48
        BNE     L187B

        LDA     #$00
        STA     terrain_draw_table_3,X
        STA     terrain_draw_table_1,X
	.L187B
        INX
        BPL     L1853

	.L187E
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.tick_door_logic
{
        LDA     door_switch_counter_A
        BEQ     door_switch_zero

        DEC     door_switch_counter_A

	.door_switch_zero
        LDA     level_number
        CMP     #$03
        BEQ     level_3_door_logic

        CMP     #$05
        BEQ     level_5_door_logic

        CMP     #$04
        BEQ     level_4_door_logic

        RTS
}

.level_5_door_logic
{
        JMP     do_level_5_door_logic
}

.level_4_door_logic
{
        JMP     do_level_4_door_logic
}

.level_3_door_logic
{
        SEC
        LDA     #$69
        SBC     window_ypos_HI_GUESS
        STA     door_logic_L0081
        LDA     #$02
        SBC     window_ypos_EXT_GUESS
        BNE     L18AE

        LDA     door_logic_L0081
        CMP     #$F1
        BCC     L18AF

	.L18AE
        RTS

	.L18AF
        LDA     door_switch_counter_A
        CMP     #$10
        BCS     L18BA

        STA     door_switch_counter_B
        JMP     L18C2

	.L18BA
        LDA     door_switch_counter_B
        CMP     #$10
        BCS     L18C2

        INC     door_switch_counter_B
	.L18C2
        SEC
        LDA     #$AE
        SBC     door_switch_counter_B
        PHA
        LDA     door_logic_L0081
        CLC
        ADC     terrain_window_y_index
        TAY
        PLA
        LDX     #$0D
	.L18D2
        STA     terrain_left_wall,Y
        INY
        DEX
        BNE     L18D2

        RTS
}

.do_level_4_door_logic
{
        SEC
        LDA     #$43
        SBC     window_ypos_HI_GUESS
        STA     door_logic_L0081
        LDA     #$03
        SBC     window_ypos_EXT_GUESS
        BNE     L18ED

        LDA     door_logic_L0081
        CMP     #$E9
        BCC     L18EE

	.L18ED
        RTS
	
	.L18EE
        LDA     door_switch_counter_A
        CMP     #$15
        BCS     L18F9

        STA     door_switch_counter_B
        JMP     L1901

	.L18F9
        LDA     door_switch_counter_B
        CMP     #$15
        BCS     L1901

        INC     door_switch_counter_B
	.L1901
        LDA     door_logic_L0081
        CLC
        ADC     terrain_window_y_index
        CLC
        ADC     #$15
        TAX
        LDA     #$A6
        LDY     #$15
	.L190F
        CPY     door_switch_counter_B
        BNE     L1915

        LDA     #$98
	.L1915
        STA     terrain_left_wall,X
        DEX
        DEY
        BNE     L190F

        RTS
}

.do_level_5_door_logic
{
        SEC
        LDA     #$70
        SBC     window_ypos_HI_GUESS
        STA     door_logic_L0081
        LDA     #$03
        SBC     window_ypos_EXT_GUESS
        BNE     L1930

        LDA     door_logic_L0081
        CMP     #$EF
        BCC     L1931

	.L1930
        RTS

	.L1931
        LDA     door_switch_counter_A
        CMP     #$12
        BCS     L193C

        STA     door_switch_counter_B
        JMP     L1944

	.L193C
        LDA     door_switch_counter_B
        CMP     #$12
        BCS     L1944

        INC     door_switch_counter_B
	.L1944
        SEC
        LDA     #$C0
        SBC     door_switch_counter_B
        PHA
        LDA     door_logic_L0081
        CLC
        ADC     terrain_window_y_index
        TAY
        PLA
        CLC
        LDX     #$07
	.L1955
        STA     terrain_left_wall,Y
        ADC     #$01
        INY
        DEX
        BNE     L1955

        SEC
        LDX     #$08
	.L1961
        STA     terrain_left_wall,Y
        SBC     #$01
        INY
        DEX
        BNE     L1961

        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.lose_a_life
{
        LDA     lives
        SEC
        SED
        SBC     #$01
        STA     lives
        CLD
        BPL     write_num_lives

        LDX     #$FF
        RTS
}

.extra_life
{
        LDA     lives
        CLC
        SED
        ADC     #$01
        STA     lives
        CLD
}

.write_num_lives
{
        PHA
        LDX     #$C1
        LDY     #$3F
        JSR     plot_char_set_scr_addr_XY

        PLA
        BEQ     zero_lives

        DEY
        LDX     #$00
        LDY     #$00
        JMP     plot_score_ext
}

.zero_lives
{
        LDA     #ASCII_space
        JSR     plot_char_A

        LDA     #$30					; ASCII '0'
        JMP     plot_char_A
}
	
	.add_score_return
       RTS

.add_A_to_score
{
        LDX     demo_mode_flag
        BNE     add_score_return

        PHA
        LDA     score_B
        AND     #$F0
        STA     add_score_L0080					; number of thousands
        PLA
        SED
        CLC
        ADC     score_A
        STA     score_A
        LDA     #$00
        ADC     score_B
        STA     score_B
        LDA     #$00
        ADC     score_C
        STA     score_C
        CLD
        LDA     score_B
        AND     #$F0
        CMP     add_score_L0080
        BEQ     write_score

        JSR     extra_life
        JSR     countdown_sound

	.write_score
        LDA     #LO(score_A)
        STA     plot_string_ptr
        LDA     #HI(score_A)
        STA     plot_string_ptr+1
        LDA     #$0F
        LDX     #$61
        LDY     #$40
        JMP     plot_three_byte_BCD_number
}

.plot_three_byte_BCD_number			; screen address in X,Y address of BCD number in L0080, A is pixel mask
\\ {
        STA     font_byte_mask
        JSR     plot_char_set_scr_addr_XY

	.plot_three_byte_BCD_number_ext
        LDX     #$00
        LDY     #$02
	.plot_BCD_loop
        LDA     (plot_string_ptr),Y
.plot_score_ext
        PHA
        ROR     A
        ROR     A
        ROR     A
        ROR     A
        AND     #$0F
        JSR     plot_number_zero_space

        PLA
        AND     #$0F
        JSR     plot_number_zero_space

        DEY
        BPL     plot_BCD_loop

        RTS
\\ }

.plot_char_set_scr_addr_XY
{
        STX     char_write_ptr_LO
        STY     char_write_ptr_HI
        RTS
}

.plot_number_zero_space
{
        BNE     plot_a_number

        CPX     #$00
        BNE     plot_a_number

        LDA     #ASCII_space
        JMP     plot_char_A

	.plot_a_number
        CLC
        ADC     #ASCII_0
        TAX
        JMP     plot_char_A
}
		
.add_fuel
{
        LDA     demo_mode_flag
        BNE     fuel_return

        LDA     #$11
        LDX     #$00
        JMP     add_A_X_to_fuel
}

.use_fuel
{
        LDA     demo_mode_flag
        BNE     fuel_return

        LDA     #$00
        STA     fuel_just_ran_out_flag
        LDA     fuel_A
        ORA     fuel_B
        ORA     fuel_C
        BNE     subtract_from_fuel
}
\\ Fall through!

.fuel_is_empty
{
        LDX     #$21
        LDY     #$3F
        JSR     plot_char_set_scr_addr_XY

        LDA     #ASCII_0
        JSR     plot_char_A

        LDA     #$FF
        STA     fuel_empty_flag
        STA     fuel_just_ran_out_flag
        RTS
}

.subtract_from_fuel
{
        LDA     #$99
        LDX     #$99
}
\\ Fall through!
		
.add_A_X_to_fuel						; add A to fuel_A, add X to fuel_B & fuel_C
{
        SED
        CLC
        ADC     fuel_A
        STA     fuel_A
        TXA
        ADC     fuel_B
        STA     fuel_B
        TXA
        ADC     fuel_C
        STA     fuel_C
        CLD
        ORA     fuel_B
        ORA     fuel_A
        BEQ     fuel_is_empty

        LDA     #$00
        STA     fuel_variable
}
\\ Fall through!

.fuel_return
{
        RTS
}

.plot_fuel_GUESS
{
        LDA     fuel_variable
        BNE     fuel_return

        LDA     fuel_empty_flag
        BMI     fuel_return

        LDA     #$DF
        STA     plot_string_ptr
        LDA     #$1A
        STA     plot_string_ptr+1
        LDA     #$0F
        STA     fuel_variable
        LDX     #$D1
        LDY     #$3E
        JMP     plot_three_byte_BCD_number
}

.plot_high_score_table
{
        LDX     #$B0
        LDY     #$4C
        JSR     plot_char_set_scr_addr_XY

        LDY     #$01
        STY     high_score_ptr_A+1
        DEY
        STY     high_score_ptr_A
        LDA     #$31
        STA     plot_high_score_number
	.L1AA9
        LDA     plot_high_score_number
        JSR     plot_char_A

        LDA     #$2E
        JSR     plot_char_A

        INC     plot_high_score_number
        JSR     plot_three_byte_BCD_number_ext

        LDA     #$30
        JSR     plot_char_A

        LDY     #$03
	.L1ABF
        LDA     (high_score_ptr_A),Y
        JSR     plot_char_A

        INY
        CPY     #$10
        BNE     L1ABF

	.L1AC9
        LDA     #$20
        JSR     plot_char_A

        INY
        CPY     #$1E
        BNE     L1AC9

        LDY     #$00
        LDA     high_score_ptr_A
        CLC
        ADC     #$10
        STA     high_score_ptr_A
        BPL     L1AA9

        RTS
}

\ ******************************************************************************
\ ******************************************************************************

\\ Fuel stored in BCD

.fuel_A
        EQUB    $00
.fuel_B
        EQUB    $00
.fuel_C
        EQUB    $00
.fuel_empty_flag
        EQUB    $00
.lives
        EQUB    $00

\ ******************************************************************************
\ ******************************************************************************

.write_game_over
        LDX		#LO(string_game_over): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_top_8_thrusters
        LDX		#LO(string_top_8_thrusters): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_string_1_unknown
		LDX		#LO(string_congratulations): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_string_2_unknown
		LDX		#LO(string_enter_name): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_press_spacebar
		LDX		#LO(string_press_spacebar): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_out_of_fuel
        LDX     #LO(string_out_of_fuel)

\\ They all fall through!
{
        LDA     #HI(in_game_messages)
        STA     plot_string_ptr+1
}
\\ Fall through!

.write_message
{
        STX     plot_string_ptr
        LDY     #$00
        LDA     (plot_string_ptr),Y
        TAX
        INY
        LDA     (plot_string_ptr),Y
        TAY
        JSR     plot_char_set_scr_addr_XY
}
\\ Fall though!

.write_message_ext
{
        LDY     #$02
        LDA     (plot_string_ptr),Y
        STA     font_byte_mask
	.loop
        INY
        LDA     (plot_string_ptr),Y
        BMI     return

        JSR     plot_char_A
        JMP     loop

	.return
        LDA     #$0F
        STA     font_byte_mask
        RTS
}

.write_in
        LDX     #LO(string_in): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_complete
        LDX     #LO(string_complete): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_failed
		LDX		#LO(string_failed)
\\ They all fall through!
{
        STX     plot_string_ptr
        LDA     #HI(end_of_level_messages)
        STA     plot_string_ptr+1
        JMP     write_message_ext
}

.write_mission
        LDX     #LO(string_mission): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_bonus
		LDX		#LO(string_bonus): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_no_bonus
		LDX		#LO(string_no_bonus): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_planet_destroyed
		LDX		#LO(string_planet_destroyed): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_reverse_gravity
		LDX		#LO(string_reverse_gravity): EQUB $2C			; BIT - has the effect of skipping next two bytes
.write_invisible_landscape
		LDX		#LO(string_invisible_landscape)

\\ They all fall through!
{
        LDA     #HI(end_of_level_messages)
        STA     plot_string_ptr+1
        JMP     write_message
}

\ ******************************************************************************
\ ******************************************************************************

.ship_input_thrust
{
        LDA     planet_exploding_state_GUESS
        BMI     L1B5F

        LDA     ship_has_pod_attached_GUESS
        BNE     L1B5F

        LDA     landscape_tick_state_GUESS
        BNE     L1B5F

        LDA     #$00
        STA     ship_force_y_HI
        STA     ship_force_y_LO
        STA     ship_force_x_HI
        STA     ship_force_x_LO
        RTS

	.L1B5F
        LDA     level_tick_counter
        AND     #$0F
        BEQ     L1B7A

        CMP     #$03
        BEQ     L1B7A

        CMP     #$05
        BEQ     L1B7A

        CMP     #$08
        BEQ     L1B7A

        CMP     #$0B
        BEQ     L1B7A

        CMP     #$0D
        BEQ     L1B7A

        RTS

	.L1B7A
        CLC
        LDA     ship_force_y_LO
        ADC     gravity_LO
        STA     ship_force_y_LO
        LDA     ship_force_y_HI
        ADC     gravity_HI
        STA     ship_force_y_HI

        LDA     planet_exploding_state_GUESS
        BPL     no_thrust

        LDA     fuel_just_ran_out_flag
        BNE     no_thrust

        LDX     #INKEY_shift
        JSR     test_inkey

        BEQ     thrust_was_pressed

	.no_thrust
        JMP     end_of_thrust_force_calculation

	.thrust_was_pressed
        JSR     use_fuel
        JSR     run_engine

        LDY     #$04
        LDA     ship_has_pod_attached_GUESS
        BEQ     L1BA6

        INY
	.L1BA6
        LDX     ship_angle
        LDA     angle_to_Y_low,X
        STA     ship_thrust_L0070
        LDA     angle_to_Y_high,X
	.L1BB0
        ROR     A
        ROR     ship_thrust_L0070
        DEY
        BNE     L1BB0

        AND     #$01
        EOR     #$FF
        CLC
        ADC     #$01
        STA     ship_thrust_L0071
        LDY     #$04
        LDA     ship_has_pod_attached_GUESS
        BEQ     L1BC6

        INY
	.L1BC6
        LDA     angle_to_X_low,X
        STA     ship_thrust_L0072
        LDA     angle_to_X_high,X
	.L1BCE
        ROR     A
        ROR     ship_thrust_L0072
        ROR     ship_thrust_L007F
        DEY
        BNE     L1BCE

        AND     #$01
        EOR     #$FF
        CLC
        ADC     #$01
        STA     L0073
        CLC
        LDA     ship_force_x_SUB
        ADC     ship_thrust_L007F
        STA     ship_force_x_SUB
        LDA     ship_force_x_LO
        ADC     ship_thrust_L0072
        STA     ship_force_x_LO
        LDA     ship_force_x_HI
        ADC     L0073
        STA     ship_force_x_HI
        CLC
        LDA     ship_force_y_LO
        ADC     ship_thrust_L0070
        STA     ship_force_y_LO
        LDA     ship_force_y_HI
        ADC     ship_thrust_L0071
        STA     ship_force_y_HI
        LDA     level_tick_counter
        AND     #$0F
        CMP     #$03
        BNE     L1C0A

        JMP     end_of_thrust_force_calculation

	.L1C0A
        CMP     #$0B
        BNE     L1C11

        JMP     end_of_thrust_force_calculation

	.L1C11
        LDA     #$00
        STA     L0079
        SEC
        SBC     angle_var_B_accumulate
        STA     ship_thrust_L007E
        LDA     ship_angle
        SBC     angle_ship_to_pod_GUESS
        TAY
        LDA     ship_thrust_L007E
        CLC
        ADC     #$08
        STA     ship_thrust_L007E
        TYA
        ADC     #$00
        AND     #$1F
        TAY
        LDA     angle_to_X_low,Y
        STA     ship_thrust_L007A
        LDA     angle_to_X_high,Y
        STA     L0078
        LDX     #$0E
	.L1C38
        LDA     ship_thrust_L007E
        AND     #$F0
        CMP     lookup_top_nibble,X
        BNE     L1C46

        INY
        TYA
        AND     #$1F
        TAY
	.L1C46
        CLC
        LDA     angle_to_X_low,Y
        ADC     ship_thrust_L007A
        STA     ship_thrust_L007A
        LDA     angle_to_X_high,Y
        ADC     L0078
        STA     L0078
        DEX
        BPL     L1C38

        LDA     L0078
        ROL     A
        ROR     L0078
        ROR     ship_thrust_L007A
        LDA     L0078
        BPL     L1C67

        LDA     #$FF
        STA     L0079
	.L1C67
        CLC
        LDA     angle_var_A
        STA     angle_var_L007D
        ADC     ship_thrust_L007A
        STA     angle_var_A
        LDA     angle_var_B
        STA     angle_var_L007B
        ADC     L0078
        STA     angle_var_B
        LDA     angle_var_C
        STA     angle_var_L007C
        ADC     L0079
        STA     angle_var_C
        LDA     angle_var_L007C
        LDX     #$06
	.L1C84
        PHA
        ROL     A
        PLA
        ROR     A
        ROR     angle_var_L007B
        ROR     angle_var_L007D
        DEX
        BNE     L1C84

        STA     angle_var_L007C

        CLC
        LDA     angle_var_A
        SBC     angle_var_L007D
        STA     angle_var_A
        LDA     angle_var_B
        SBC     angle_var_L007B
        STA     angle_var_B
        LDA     angle_var_C
        SBC     angle_var_L007C
        STA     angle_var_C

.end_of_thrust_force_calculation
        LDA     ship_force_x_SUB
        STA     ship_thrust_L0070
        LDA     ship_force_x_LO
        STA     ship_thrust_L0071
        LDA     ship_force_x_HI
        LDX     #$06
	.L1CB0
        PHA
        ROL     A
        PLA
        ROR     A
        ROR     ship_thrust_L0071
        ROR     ship_thrust_L0070
        DEX
        BNE     L1CB0

        STA     ship_thrust_L0072
        SEC
        LDA     ship_force_x_SUB
        SBC     ship_thrust_L0070
        STA     ship_force_x_SUB
        LDA     ship_force_x_LO
        SBC     ship_thrust_L0071
        STA     ship_force_x_LO
        LDA     ship_force_x_HI
        SBC     ship_thrust_L0072
        STA     ship_force_x_HI
        LDA     #$00
        STA     L0073
	.L1CD4
        LDA     ship_force_y_HI
        L1CD5   = L1CD4+1
        BPL     L1CDC

        LDA     #$FF
        STA     L0073
	.L1CDC
        LDA     ship_force_y_LO
        STA     ship_thrust_L0070
        LDA     ship_force_y_HI
        STA     ship_thrust_L0071
        LDA     L0073
        LDX     #$08
	.L1CE8
        PHA
        ROL     A
        PLA
        ROR     A
        ROR     ship_thrust_L0071
        ROR     ship_thrust_L0070
        DEX
        BNE     L1CE8

        STA     ship_thrust_L0072
        SEC
        LDA     ship_force_y_LO
        SBC     ship_thrust_L0070
        STA     ship_force_y_LO
        LDA     ship_force_y_HI
        SBC     ship_thrust_L0071
        STA     ship_force_y_HI
        LDA     L0073
        SBC     ship_thrust_L0072
        STA     L0073
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.lookup_top_nibble
		EQUB	$10,$20,$30,$40,$50,$60,$70,$80,$90,$A0,$B0,$C0,$D0,$E0,$F0

\ ******************************************************************************
\ ******************************************************************************

.test_for_pause
{
		LDX		#INKEY_copy
		JSR		test_inkey
        BNE     not_paused

        LDA     shield_tractor_pressed
        BNE     not_paused

	.pause_loop
        LDA     #$01
        STA     level_tick_state_GUESS

        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE					; *FX 15 - flush all buffers

        JSR     OSRDCH					; read character from input stream

        CMP     #ASCII_delete			; unpause key
        BNE     pause_loop

        JSR     reset_system_clock

        LDA     #$00
        STA     level_tick_state_GUESS

	.not_paused
        LDX     #INKEY_Q				; quiet key
        JSR     test_inkey

        BNE     q_not_pressed
        STX     mute_sound_flag

	.q_not_pressed
        LDX     #INKEY_S				; sound key
        JSR     test_inkey

        BNE     s_not_pressed

        LDA     #$00
        STA     mute_sound_flag

	.s_not_pressed
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

\\ This code is not called directly - these bytes are used to write over existing code
.ship_AND_pixel_mask_CODE
        AND     pixel_masks_1,X
.ship_SKIP_pixel_mask_CODE
        JMP     plot_ship_loop
\\

\ ******************************************************************************
\ ******************************************************************************

.test_and_update_sheild_tractor
{
        JSR     calculate_attached_pod_vector_GUESS

        LDA     gravity_HI
        BPL     L1D61

        JSR     plot_pod_sprite_GUESS

	.L1D61
        LDA     general_flag_D
        BNE     ship_input_shield_tractor

        JMP     L1DB3

	.ship_input_shield_tractor
        LDA     #$00
        STA     shield_tractor_pressed
        STA     sheild_tractor_flag

        LDA     planet_exploding_state_GUESS
        BPL     no_sheild_tractor

        LDA     fuel_just_ran_out_flag
        BNE     no_sheild_tractor

        LDX     #INKEY_spacebar
        JSR     test_inkey

        STX     shield_tractor_pressed
        CPX     #$00
        BEQ     no_sheild_tractor

        LDA     vsync_count
        AND     #$02
        BEQ     no_sheild_tractor

        LDA     #$01
        STA     sheild_tractor_flag

        JSR     use_fuel
        JSR     run_engine_ext

	.no_sheild_tractor
        LDA     #$00
        STA     general_flag_D
		
        LDX     #$02
	.overwrite_ship_pixel_AND_CODE
        LDA     ship_AND_pixel_mask_CODE,X
        STA     ship_pixel_mask_test,X						; **MODIFIES CODE**
        DEX
        BPL     overwrite_ship_pixel_AND_CODE

        LDA     L0072_old_shield_tractor
        STA     shield_tractor_L0072
        LDA     L0073_old_shield_tractor
        STA     L0073
        LDA     L0076_old_shield_tractor
        STA     L0076
        LDA     L0075_old_shield_tractor
        STA     L0075
        JSR     plot_ship

	.L1DB3
        LDX     #$02
	.overwrite_ship_pixel_SKIP_CODE
        LDA     ship_SKIP_pixel_mask_CODE,X
        STA     ship_pixel_mask_test,X						; **MODIFIES CODE**
        DEX
        BPL     overwrite_ship_pixel_SKIP_CODE

        LDA     ship_angle
        STA     L0076
        STA     L0076_old_shield_tractor
        LDA     sheild_tractor_flag
        BEQ     L1DCE

        LDA     #$FF
        STA     L0076
        STA     L0076_old_shield_tractor
	.L1DCE
        CLC
        LDA     ship_ypos_LO_GUESS
        ADC     pod_vector_y_LO_GUESS
        STA     L0079
        LDA     relative_ship_ypos_HI_GUESS
        ADC     pod_vector_y_HI_GUESS
        STA     relative_pod_ypos_HI_GUESS
        LDX     ship_angle
        LDA     L0076
        BPL     L1DFB

        LDA     angle_to_Y_low,X
        STA     sheild_tractor_L007B
        LDA     angle_to_Y_high,X
        STA     sheild_tractor_L007C
        ROL     A
        ROR     sheild_tractor_L007C
        LDA     sheild_tractor_L007B
        ROR     A
        ADC     L0079
        STA     L0079
        LDA     sheild_tractor_L007C
        ADC     relative_pod_ypos_HI_GUESS
        STA     relative_pod_ypos_HI_GUESS
	.L1DFB
        ROL     L0079
        ROL     relative_pod_ypos_HI_GUESS
        CLC
        LDA     ship_xpos_SUB_GUESS
        ADC     pod_vector_x_SUB_GUESS
        LDA     ship_xpos_LO_GUESS
        ADC     pod_vector_x_LO_GUESS
        PHA
        STA     pod_xpos_LO_GUESS
        LDA     relative_ship_xpos_HI_GUESS
        ADC     pod_vector_x_HI_GUESS
        STA     L0077
        STA     relative_pod_xpos_HI_GUESS
        LDA     L0076
        BPL     L1E30

        LDA     angle_to_X_low,X
        STA     sheild_tractor_L007B
        LDA     angle_to_X_high,X
        STA     sheild_tractor_L007C
        ROL     A
        ROR     sheild_tractor_L007C
        ROR     sheild_tractor_L007B
        PLA
        ADC     sheild_tractor_L007B
        PHA
        LDA     L0077
        ADC     sheild_tractor_L007C
        STA     L0077
	.L1E30
        PLA
        ROL     A
        ROL     A
        ROL     A
        AND     #$03
        STA     L0075
        STA     L0075_old_shield_tractor
        LDA     #$00
        STA     shield_tractor_L0072
        STA     shield_tractor_L0070
        LDA     relative_pod_ypos_HI_GUESS
        CLC
        AND     #$F8
        ROR     A
        ROR     A
        STA     L0073
        ROR     A
        ROR     A
        ROR     shield_tractor_L0072
        ROR     A
        ROR     shield_tractor_L0072
        ADC     #$38
        ADC     L0073
        STA     L0073
        LDA     landscape_tick_state_GUESS
        BMI     L1E61

        LDA     #$00
        STA     landscape_tick_state_GUESS
        JMP     plot_pod_sprite_GUESS

	.L1E61
        LDA     collision_flag_GUESS
        BNE     L1E88

        LDA     #$01
        STA     general_flag_D
        LDY     L0077
        LDA     mult_by_8_table_low,Y
        ADC     shield_tractor_L0072
        STA     shield_tractor_L0072
        LDA     mult_by_8_table_high,Y
        ADC     L0073
        STA     L0073
        STA     L0073_old_shield_tractor
        LDA     relative_pod_ypos_HI_GUESS
        AND     #$07
        ADC     shield_tractor_L0072
        STA     shield_tractor_L0072
        STA     L0072_old_shield_tractor
        JSR     plot_ship

	.L1E88
        LDA     gravity_HI
        BMI     return

        JSR     plot_pod_sprite_GUESS

	.return
        RTS
}

.plot_ship
{
        LDA     #LO(pixel_masks_3)
        STA     ship_pixel_mask_addr_LO					; **MODIFIES CODE**
        LDA     #HI(pixel_masks_3)
        STA     ship_pixel_mask_addr_HI					; **MODIFIES CODE**
        LDA     #$C9					; OPCODE CMP IMMEDIATE
        STA     plot_ship_write_opcode					; **MODIFIES CODE**
        LDA     #$FF					; OPCODE value
        STA     plot_ship_write_value					; **MODIFIES CODE**
        LDA     L0076
        BPL     L1EB7

        LDA     #LO(pixel_masks_1)
        STA     ship_pixel_mask_addr_LO					; **MODIFIES CODE**
        LDA     #HI(pixel_masks_1)
        STA     ship_pixel_mask_addr_HI					; **MODIFIES CODE**

		LDA     #$11					; sheild sprite?
        JMP     L1ECB

	.L1EB7
        CMP     #$11
        BCC     L1ECB

        LDA     #$49					; OPCODE EOR IMMEDIATE
        STA     plot_ship_write_opcode					; **MODIFIES CODE**
        LDA     #$1F					; OPCODE value
        STA     plot_ship_write_value					; **MODIFIES CODE**
        LDA     L0076
        EOR     #$1F
        ADC     #$00
	.L1ECB
        TAY
        LDA     sprite_ptr_table_LO,Y
        STA     ship_sprite_addr_1_LO					; **MODIFIES CODE**
        STA     ship_sprite_addr_2_LO					; **MODIFIES CODE**
        STA     ship_sprite_addr_3_LO					; **MODIFIES CODE**
        LDA     sprite_ptr_table_HI,Y
        STA     ship_sprite_addr_1_HI					; **MODIFIES CODE**
        STA     ship_sprite_addr_2_HI					; **MODIFIES CODE**
        STA     ship_sprite_addr_3_HI					; **MODIFIES CODE**
        LDA     shield_tractor_L0072
        AND     #$07
        EOR     #$07
        STA     shield_tractor_L0070
        LDX     #$00
        JMP     plot_ship_start
}

.plot_ship_loop
\\ {
        LDX     plot_ship_index
        INX
.plot_ship_start
        STX     plot_ship_index
.L1EF6
        LDA     ship_sprite_0_data,X		; **SELF-MODIFIED CODE**
        ship_sprite_addr_1_LO   = L1EF6+1
        ship_sprite_addr_1_HI   = L1EF6+2
        BMI     L1F1F

	.plot_ship_inner_loop
        SEC
.plot_ship_write_opcode
        EOR     #$1F					; **SELF-MODIFIED CODE**
        plot_ship_write_value   = plot_ship_write_opcode+1

        ADC     L0075
        TAY
        AND     #$3C
        ROL     A
        STA     plot_ship_L0071
        TYA
        AND     #$03
        TAX

.ship_load_pixel_mask
        LDA     pixel_masks_1,X			; **SELF-MODIFIED CODE**
        ship_pixel_mask_addr_LO   = ship_load_pixel_mask+1
        ship_pixel_mask_addr_HI   = ship_load_pixel_mask+2

        LDY     plot_ship_L0071
        EOR     (shield_tractor_L0072),Y
        STA     (shield_tractor_L0072),Y

.ship_pixel_mask_test
        AND     pixel_masks_1,X			; **SELF-MODIFIED CODE**
        BEQ     plot_ship_loop

        LDA     #$FF
        STA     collision_flag_GUESS
        JMP     plot_ship_loop

	.L1F1F
        CMP     #$FF
        BEQ     plot_ship_return

        LDX     plot_ship_index
        DEC     shield_tractor_L0070
        BMI     L1F35

        INC     shield_tractor_L0072
.L1F2B
        LDA     ship_sprite_4_data,X				; **SELF-MODIFIED CODE**
        ship_sprite_addr_2_LO   = L1F2B+1
        ship_sprite_addr_2_HI   = L1F2B+2
        CMP     #$80
        BNE     plot_ship_inner_loop

        JMP     plot_ship_loop

	.L1F35
        LDA     #$07
        STA     shield_tractor_L0070
        CLC
        LDA     shield_tractor_L0072
        ADC     #$39
        STA     shield_tractor_L0072
        LDA     L0073
        ADC     #$02
        STA     L0073					; $239 - character row bytes - 7
	.L1F46
        LDA     ship_sprite_4_data,X				; **SELF-MODIFIED CODE**
        ship_sprite_addr_3_LO   = L1F46+1
        ship_sprite_addr_3_HI   = L1F46+2
        CMP     #$80
        BNE     plot_ship_inner_loop

        JMP     plot_ship_loop

	.plot_ship_return
        RTS
\\ }

.calculate_attached_pod_vector_GUESS
{
        LDA     angle_var_B_accumulate
        CLC
        ADC     #$08
        STA     pod_vector_L007A
        LDA     angle_ship_to_pod_GUESS
        ADC     #$00
        AND     #$1F
        TAY
        LDA     angle_to_X_low,Y
        STA     pod_vector_x_LO_GUESS
        LDA     angle_to_X_high,Y
        STA     pod_vector_x_HI_GUESS
        LDA     angle_to_Y_low,Y
        STA     pod_vector_y_LO_GUESS
        LDA     angle_to_Y_high,Y
        STA     pod_vector_y_HI_GUESS
        LDX     sprite_nibble_index_GUESS
	.L1F75
        LDA     pod_vector_L007A
        AND     #$F0
        CMP     lookup_top_nibble,X
        BNE     L1F83

        INY
        TYA
        AND     #$1F
        TAY
	.L1F83
        CLC
        LDA     angle_to_X_low,Y
        ADC     pod_vector_x_LO_GUESS
        STA     pod_vector_x_LO_GUESS
        LDA     angle_to_X_high,Y
        ADC     pod_vector_x_HI_GUESS
        STA     pod_vector_x_HI_GUESS
        CLC
        LDA     angle_to_Y_low,Y
        ADC     pod_vector_y_LO_GUESS
        STA     pod_vector_y_LO_GUESS
        LDA     angle_to_Y_high,Y
        ADC     pod_vector_y_HI_GUESS
        STA     pod_vector_y_HI_GUESS
        DEX
        BPL     L1F75

        LDA     pod_vector_x_HI_GUESS
        ROL     A
        ROR     pod_vector_x_HI_GUESS
        ROR     pod_vector_x_LO_GUESS
        ROR     pod_vector_x_SUB_GUESS
        LDA     pod_vector_x_HI_GUESS
        ROL     A
        ROR     pod_vector_x_HI_GUESS
        ROR     pod_vector_x_LO_GUESS
        ROR     pod_vector_x_SUB_GUESS
        LDA     pod_vector_y_HI_GUESS
        ROL     A
        ROR     pod_vector_y_HI_GUESS
        ROR     pod_vector_y_LO_GUESS
        LDA     pod_vector_y_HI_GUESS
        ROL     A
        ROR     pod_vector_y_HI_GUESS
        ROR     pod_vector_y_LO_GUESS
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.start_tractor_beam_GUESS
{
        LDA     general_flag_C
        BNE     L1FD3

        LDA     level_objects_flags
        AND     #$03
        CMP     #$03
        BEQ     L1FD3

        RTS

	.L1FD3
        LDA     tractor_beam_pod_flag_UNKNOWN
        BMI     tractor_beam_return

        LDA     shield_tractor_pressed
        BNE     do_tractor_beam_GUESS

        STA     tractor_beam_flag_unknown
        RTS
}

.do_tractor_beam_GUESS
{
        LDA     planet_exploding_state_GUESS
        BPL     tractor_beam_return

        LDA     tractor_beam_flag_unknown
        STA     pod_flag_unknown
		
        JSR     do_tractor_beam_GUESS_UNKNOWN_FN

        CMP     #$75
        BCC     L1FF3

        CMP     #$84
        BCS     attach_pod_to_ship_GUESS

        RTS

	.L1FF3
        LDA     #$01
        STA     tractor_beam_flag_unknown
        STA     pod_flag_unknown
}
\\ Fall through!

.tractor_beam_return
{
        RTS
}

.attach_pod_to_ship_GUESS
{
        LDA     tractor_beam_flag_unknown
        BEQ     tractor_beam_return

        LDA     #$FF
        STA     ship_has_pod_attached_GUESS
        STA     tractor_beam_pod_flag_UNKNOWN
        STA     level_reset_flag_GUESS

        CLC
        LDA     player_xpos_LO_GUESS
        ADC     xpos_var_E_LO_GUESS
        STA     ship_xpos_LO_GUESS
        LDA     player_xpos_HI_GUESS
        ADC     xpos_var_E_HI_GUESS
        ROR     A
        STA     ship_xpos_HI_GUESS
        ROR     ship_xpos_LO_GUESS
        CLC
        LDA     player_ypos_LO_GUESS
        ADC     #$80
        STA     ship_ypos_LO_GUESS
        LDA     player_ypos_HI_GUESS
        ADC     ypos_var_E_HI_GUESS
        STA     ship_ypos_HI_GUESS
        LDA     player_ypos_EXT_GUESS
        ADC     ypos_var_E_EXT_GUESS
        ROR     A
        STA     ship_ypos_EXT_GUESS
        ROR     ship_ypos_HI_GUESS
        ROR     ship_ypos_LO_GUESS
        LDA     ship_force_y_HI
        ROL     A
        ROR     ship_force_y_HI
        ROR     ship_force_y_LO
        LDA     ship_force_x_HI
        ROL     A
        ROR     ship_force_x_HI
        ROR     ship_force_x_LO
        ROR     ship_force_x_SUB
        LDA     player_xpos_LO_GUESS
        SBC     ship_xpos_LO_GUESS
        STA     L0074
        LDA     player_xpos_HI_GUESS
        SBC     ship_xpos_HI_GUESS
        STA     L0075
        ROL     L0074
        ROL     L0075
        ROL     L0074
        ROL     L0075
        LDA     L0075
        STA     attach_pod_L0072
        LDA     player_ypos_LO_GUESS
        SBC     ship_ypos_LO_GUESS
        STA     L0076
        LDA     player_ypos_HI_GUESS
        SBC     ship_ypos_HI_GUESS
        STA     L0077
        ROL     L0076
        ROL     L0077
        LDA     L0077
        STA     L0073
        LDA     #$0A
        STA     attach_pod_L007B
        LDA     #$AB
        STA     attach_pod_L007A
        LDA     #$07
        STA     attach_pod_L007C
        LDA     #$00
        STA     angle_var_B_accumulate
        STA     angle_ship_to_pod_GUESS
	.L207E
        LDA     #$FF
        STA     attach_pod_L0071
        LDX     #$03
        STX     L0078
	.L2086
        JSR     calculate_attached_pod_vector_GUESS

        ROL     pod_vector_x_LO_GUESS
        ROL     pod_vector_x_HI_GUESS
        ROL     pod_vector_x_LO_GUESS
        ROL     pod_vector_x_HI_GUESS
        ROL     pod_vector_y_LO_GUESS
        ROL     pod_vector_y_HI_GUESS
        SEC
        LDA     pod_vector_x_HI_GUESS
        SBC     L0075
        BPL     L20A0

        EOR     #$FF
        ADC     #$01
	.L20A0
        STA     attach_pod_L0088
        SEC
        LDA     pod_vector_y_HI_GUESS
        SBC     L0077
        BPL     L20AD

        EOR     #$FF
        ADC     #$01
	.L20AD
        STA     attach_pod_L0089
        JSR     L2F0F

        CMP     attach_pod_L0071
        BCS     L20C0

        STA     attach_pod_L0071
        LDA     angle_var_B_accumulate
        STA     angle_var_L007D
        LDA     angle_ship_to_pod_GUESS
        STA     temp_L007E
	.L20C0
        CLC
        LDA     angle_var_B_accumulate
        ADC     attach_pod_L007A
        STA     angle_var_B_accumulate
        LDA     angle_ship_to_pod_GUESS
        ADC     attach_pod_L007B
        AND     #$1F
        STA     angle_ship_to_pod_GUESS
        DEC     L0078
        BNE     L2086

        LDA     angle_var_L007D
        STA     angle_var_B_accumulate
        LDA     temp_L007E
        STA     angle_ship_to_pod_GUESS
        CLC
        ROR     attach_pod_L007B
        ROR     attach_pod_L007A
        DEC     attach_pod_L007C
        BEQ     L20F6

        SEC
        LDA     angle_var_B_accumulate
        SBC     attach_pod_L007A
        STA     angle_var_B_accumulate
        LDA     angle_ship_to_pod_GUESS
        SBC     attach_pod_L007B
        AND     #$1F
        STA     angle_ship_to_pod_GUESS
        JMP     L207E

	.L20F6
        LDA     ship_force_x_HI
        STA     attach_pod_L0088
        LDA     ship_force_x_LO
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        LDA     L0073
        JSR     tractor_beam_fn_UNKNOWN

        LDA     attach_pod_L0089
        STA     attach_pod_L008E
        LDA     attach_pod_L008A
        STA     attach_pod_L008F
        LDA     ship_force_y_HI
        STA     attach_pod_L0088
        LDA     ship_force_y_LO
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        ROL     A
        ROL     attach_pod_L0088
        LDA     attach_pod_L0072
        JSR     tractor_beam_fn_UNKNOWN

        SEC
        LDA     attach_pod_L0089
        SBC     attach_pod_L008E
        STA     angle_var_B
        LDA     attach_pod_L008A
        SBC     attach_pod_L008F
        PHA
        ROL     A
        PLA
        ROR     A
        ROR     angle_var_B
        PHA
        ROL     A
        PLA
        ROR     A
        ROR     angle_var_B
        STA     angle_var_C
        JSR     collect_pod_fuel_sound

        RTS
}

