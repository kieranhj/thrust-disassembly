.gun_bullet_x_offset
        EQUB    $04,$04,$01,$01

.gun_bullet_y_offset
        EQUB    $00,$08,$00,$08

.gun_param_B_table
        EQUB    $01,$03,$07,$0F

\ ******************************************************************************
\ ******************************************************************************

.object_visibility_test
\\ {
        LDA     level_0_obj_pos_X,X				; **SELF-MODIFIED CODE**
		level_obj_pos_X_addr_LO 	= object_visibility_test+1
		level_obj_pos_X_addr_HI 	= object_visibility_test+2
        STA     current_obj_pos_X

	.L10E8
        LDA     level_0_obj_pos_Y,X				; **SELF-MODIFIED CODE**
        level_obj_pos_Y_addr_LO   = L10E8+1
        level_obj_pos_Y_addr_HI   = L10E8+2
        STA     current_obj_pos_Y

	.L10ED
        LDA     level_0_obj_pos_Y_EXT,X			; **SELF-MODIFIED CODE**
        level_obj_pos_Y_EXT_addr_LO   = L10ED+1
        level_obj_pos_Y_EXT_addr_HI   = L10ED+2
        STA     current_obj_pos_Y_EXT

        LDA     #$00
        STA     obj_vis_test_flag_GUESS
        SEC
        LDA     current_obj_pos_Y
        SBC     window_ypos_HI_GUESS
        STA     L0074
        LDA     current_obj_pos_Y_EXT
        SBC     window_ypos_EXT_GUESS
        STA     L0075
        BNE     L1126

        LDA     #$01
        STA     obj_vis_test_flag_GUESS
        SEC
        LDA     L0074
        SBC     #$38
        STA     L0074
        CMP     #$11
        BCC     L1126

        CMP     #$7E
        BCS     L1126

        LDY     object_type
        SEC
        LDA     current_obj_pos_X
        SBC     window_xpos_HI_GUESS
        STA     L0073
        CMP     object_type_cull_size_GUESS,Y
        BCC     object_is_visible

	.L1126
        RTS
\\ }

.object_type_cull_size_GUESS
        EQUB    $44,$44,$44,$44,$45,$45,$44,$47,$47

.object_is_visible
{
        LDA     current_object
        BNE     L1160

        LDA     L0074
        SEC
        SBC     general_var_B_HI
        ROL     A
        SEC
        SBC     #$05
        STA     pod_to_ship_vector_y_HI_GUESS
        SEC
        LDA     L0073
        SBC     #$02
        SEC
        SBC     window_var_unknown
        STA     pod_to_ship_vector_x_HI_GUESS
        LDA     #$40
        STA     pod_to_ship_vector_x_LO_GUESS
        LDA     #$00
        STA     xpos_var_E_LO_GUESS
        LDA     current_obj_pos_X
        SEC
        SBC     #$02
        STA     xpos_var_E_HI_GUESS
        LDA     current_obj_pos_Y_EXT
        STA     ypos_var_E_EXT_GUESS
        LDA     current_obj_pos_Y
        STA     ypos_var_E_HI_GUESS

	.L1160
        CLC
        ROL     L0074
        LDY     #$00
        STY     L0076
        STY     L0079
        LDA     L0074
        AND     #$07
        STA     L0078
        LDA     L0074
        LSR     A
        LSR     A
        AND     #$FE
        STA     L0077
        LSR     A
        LSR     A
        ROR     L0076
        LSR     A
        ROR     L0076
        ADC     L0077
        ADC     #$38
        TAX
        LDA     L0073
        ASL     A
        ASL     A
        ROL     L0079
        ASL     A
        ROL     L0079
        AND     #$F8
        ADC     L0078
        ADC     L0076
        STA     obj_sprite_ptr_LO
        TXA
        ADC     L0079
        STA     obj_sprite_ptr_HI
        RTS
}

\ ******************************************************************************
\ * Sprite routines and data
\ ******************************************************************************

\ ******************************************************************************
\ * L0070, L0071 address as input
\ ******************************************************************************
		
.plot_static_sprite
\\ {
        LDX     current_object
        LDA     level_objects_flags,X
        ORA     #$01
        STA     level_objects_flags,X
        LDA     plot_static_sprite_L0070
        AND     #$07
        EOR     #$07
        STA     plot_static_sprite_L0072
        INC     plot_static_sprite_L0072
        LDX     #$00
        JMP     L11DB

	.L11B3
        INC     plot_static_sprite_L0070
        TYA
        AND     #$7F
        TAY
        DEC     plot_static_sprite_L0072
        BNE     L11D3

        DEC     plot_static_sprite_L0070
        LDA     plot_static_sprite_L0070
        ADC     #$39
        STA     plot_static_sprite_L0070
        LDA     plot_static_sprite_L0071
        ADC     #$02
        STA     plot_static_sprite_L0071
        LDA     #$08
        STA     plot_static_sprite_L0072
        TYA
        AND     #$7F
        TAY
	.L11D3
        LDA     sprite_data_B_obj_3,X					; **SELF-MODIFIED CODE**
        sprite_data_B_ptr_LO   = L11D3+1
        sprite_data_B_ptr_HI   = L11D3+2
        EOR     (plot_static_sprite_L0070),Y
        STA     (plot_static_sprite_L0070),Y
        INX
	.L11DB
        LDY     sprite_data_A_obj_3,X					; **SELF-MODIFIED CODE**
        sprite_data_A_ptr_LO   = L11DB+1
        sprite_data_A_ptr_HI   = L11DB+2
        BPL     L11D3

        CPY     #$FF
        BNE     L11B3

        RTS
\\ }

