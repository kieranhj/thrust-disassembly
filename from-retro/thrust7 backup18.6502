.generate_stars_to_start_GUESS
{
        LDA     #$08
        STA     L0076
        LDA     #$A0
        STA     shield_tractor_L0072
        LDA     #$56
        STA     shield_tractor_L0073
        LDA     #$00
        STA     window_xpos_HI_GUESS
        STA     window_ypos_EXT_GUESS
        STA     L0075
        JSR     plot_ship

.L2160
        JSR     particles_update_and_draw						; maybe draw or collision?

        INC     level_tick_counter
        LDY     #$03
        JSR     wait_time_out_Y

        INC     window_xpos_HI_GUESS
        BNE     L2160

        RTS
}

