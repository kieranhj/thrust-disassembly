\ ******************************************************************************
\ ******************************************************************************

.irq1_handler
{
        PHP
        PHA
        LDA     #$02
        BIT     SHEILA_System_VIA_Interrupt_Flag
        BNE     irq1_vsync

        LDA     #$40
        BIT     SHEILA_User_VIA_Interrupt_Flag
        BNE     irq1_timer1

        PLA
        PLP
        JMP     (old_irq1v)

	.irq1_timer1
        LDA     SHEILA_User_VIA_Timer1_Low_Order
        LDA     #$01
        STA     irq1_timer1_signal
        PLA
        PLP
        LDA     IRQ1_FLAGS
        RTI

	.irq1_vsync
        TXA
        PHA
        TYA
        PHA
        LDA     SHEILA_System_VIA_Register_A
        LDA     #$80
        STA     SHEILA_User_VIA_Aux_Ctrl_Reg
        LDA     #$C0
        STA     SHEILA_User_VIA_Interrupt_Enable
        LDA     #$00
        STA     SHEILA_User_VIA_Timer1_Low_Order
        LDA     #$38
        STA     SHEILA_User_VIA_Timer1_High_Order
        LDA     #$D8
        STA     SHEILA_Video_ULA
        LDA     #$00
        STA     irq1_timer1_signal
        INC     vsync_count
        LDX     planet_explode_anim
        BEQ     irq1_return

        LDA     background_colour_table,X
        LDY     #$00
        JSR     palette_set_colour_Y_to_A

        LDA     #$00
        LDY     #$02
        JSR     palette_set_colour_Y_to_A

        LDA     vsync_count
        AND     #$01
        BEQ     irq1_return

        DEC     planet_explode_anim
	.irq1_return
        PLA
        TAY
        PLA
        TAX
        PLA
        PLP
        LDA     IRQ1_FLAGS
        RTI
}

.background_colour_table
        EQUB    $00,$00,$04,$01,$05,$02,$06,$03
        EQUB    $07,$07,$03,$06,$02,$05,$01,$04

\ ******************************************************************************
\ ******************************************************************************

.ship_input_rotate
{
        LDA     level_tick_counter
        AND     #$03
        BEQ     rotate_return

        LDX     #INKEY_capslock
        JSR     test_inkey
        BNE     rotate_left_not_pressed

        DEC     ship_angle
		
	.rotate_left_not_pressed
        LDX     #INKEY_ctrl
        JSR     test_inkey
        BNE     rotate_right_not_pressed

        INC     ship_angle

	.rotate_right_not_pressed
        LDA     ship_angle
        AND     #$1F
        STA     ship_angle

	.rotate_return
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.ship_update_position
{
        CLC
        LDA     ship_xpos_SUB_GUESS
        ADC     ship_force_x_SUB
        STA     ship_xpos_SUB_GUESS
        LDA     ship_xpos_LO_GUESS
        ADC     ship_force_x_LO
        STA     ship_xpos_LO_GUESS
        LDA     ship_xpos_HI_GUESS
        ADC     ship_force_x_HI
        STA     ship_xpos_HI_GUESS

        CLC
        LDA     ship_ypos_LO_GUESS
        ADC     ship_force_y_LO
        STA     ship_ypos_LO_GUESS
        LDA     ship_force_y_HI
        BMI     ship_force_negative

        ADC     ship_ypos_HI_GUESS
        STA     ship_ypos_HI_GUESS
        BCC     ship_ypos_no_ext

        INC     ship_ypos_EXT_GUESS
        JMP     ship_ypos_no_ext

	.ship_force_negative
        ADC     ship_ypos_HI_GUESS
        STA     ship_ypos_HI_GUESS
        BCS     ship_ypos_no_ext

        DEC     ship_ypos_EXT_GUESS
	.ship_ypos_no_ext
        LDA     planet_exploding_state_GUESS
        BPL     L23A7

        LDA     ship_has_pod_attached_GUESS
        BEQ     ship_update_position_return

	.L23A7
        CLC
        LDA     angle_var_A
        ADC     angle_var_A_accumulate
        STA     angle_var_A_accumulate
        LDA     angle_var_B
        ADC     angle_var_B_accumulate
        STA     angle_var_B_accumulate
        LDA     angle_var_C
        ADC     angle_ship_to_pod_GUESS
        AND     #$1F
        STA     angle_ship_to_pod_GUESS

	.ship_update_position_return
        RTS
}

\ ******************************************************************************
\ * Inputs: ship_xpos_SUB_GUESS, ship_xpos_LO_GUESS, ship_xpos_HI_GUESS, ship_ypos_LO_GUESS
\ * ship_ypos_HI_GUESS, ship_ypos_EXT_GUESS
\ * Outputs: player_xpos_LO_GUESS, player_xpos_HI_GUESS, player_ypos_LO_GUESS
\ * player_ypos_HI_GUESS, player_ypos_EXT_GUESS,
\ * player_velocity_x_low_GUESS, player_velocity_x_high_GUESS
\ * player_velocity_y_low_GUESS, player_velocity_y_high_GUESS
\ *
\ * temp_ship_xpos_SUB_GUESS = ship_xpos_SUB_GUESS
\ * L0071 = ship.xpos + xpos_var_C
\ * L0073 = ship.ypos + ypos_var_C	; test for ypos_var_C.HI negative -> vector
\ * diff_ship_xpos_SUB_GUESS = temp_ship_xpos_SUB_GUESS - old_ship_xpos_SUB_GUESS
\ * velocity.xpos = ship.xpos + var_C.xpos - player.xpos
\ * old_player.xpos = player.xpos
\ * player.xpos = ship.xpos + varC.xpos
\ ******************************************************************************
.ship_pos_to_player_pos
{
        CLC
        LDA     ship_xpos_SUB_GUESS
        STA     temp_ship_xpos_SUB_GUESS

        LDA     ship_xpos_LO_GUESS			; D = B + C
        ADC     pod_vector_x_LO_GUESS
        STA     ship_pos_L0071
        LDA     ship_xpos_HI_GUESS
        ADC     pod_vector_x_HI_GUESS
        STA     ship_pos_L0072

        CLC
        LDA     ship_ypos_LO_GUESS
        ADC     pod_vector_y_LO_GUESS
        STA     L0073
        LDA     ship_ypos_HI_GUESS
        ADC     pod_vector_y_HI_GUESS
        STA     L0074
        PHP
        LDA     pod_vector_y_HI_GUESS
        BMI     L23E5

        LDA     #$00
        JMP     L23E7

	.L23E5
        LDA     #$FF
	.L23E7
        PLP
        ADC     ship_ypos_EXT_GUESS
        STA     L0075

        SEC
        LDA     temp_ship_xpos_SUB_GUESS
        SBC     old_ship_xpos_SUB_GUESS
        STA     diff_ship_xpos_SUB_GUESS
		
        LDA     ship_pos_L0071
        SBC     player_xpos_LO_GUESS
        STA     player_velocity_x_low_GUESS
        LDA     ship_pos_L0072
        SBC     player_xpos_HI_GUESS
        STA     player_velocity_x_high_GUESS

        SEC
        LDA     L0073
        SBC     player_ypos_LO_GUESS
        STA     player_velocity_y_low_GUESS
        LDA     L0074
        SBC     player_ypos_HI_GUESS
        STA     player_velocity_y_high_GUESS
        LDA     L0075
        SBC     player_ypos_EXT_GUESS
        STA     player_velocity_y_ext_GUESS

        LDA     player_xpos_LO_GUESS
        STA     old_player_xpos_LO_GUESS
        LDA     player_xpos_HI_GUESS
        STA     old_player_xpos_HI_GUESS
        LDA     player_ypos_HI_GUESS
        STA     old_player_ypos_HI_GUESS
        LDA     player_ypos_EXT_GUESS
        STA     old_player_ypos_EXT_GUESS

        LDA     temp_ship_xpos_SUB_GUESS
        STA     old_ship_xpos_SUB_GUESS

        LDA     ship_pos_L0071
        STA     player_xpos_LO_GUESS
        LDA     ship_pos_L0072
        STA     player_xpos_HI_GUESS
        LDA     L0073
        STA     player_ypos_LO_GUESS
        LDA     L0074
        STA     player_ypos_HI_GUESS
        LDA     L0075
        STA     player_ypos_EXT_GUESS
        RTS
}

\ ******************************************************************************
\ ******************************************************************************

.create_explosion
{
        JSR     explosion_sound

        LDX     #$08
        LDA     explosion_particle_type
        CMP     #$04						; random debris
        BNE     loop

        LDX     #$03
        LDA     level_tick_counter
        AND     #$01
        STA     explosion_particle_type
        INC     explosion_particle_type
        JSR     rnd

        AND     #$1F
        STA     explosion_param_1
	.loop
        STX     explosion_particle_count
        JSR     particle_return_free_slot_in_Y

        LDA     explosion_xpos_low
        STA     particles_xpos_low,Y
        LDA     explosion_xpos_high
        STA     particles_xpos_high,Y
        LDA     explosion_ypos_high
        STA     particles_ypos_high,Y
        LDA     explosion_ypos_ext
        STA     particles_ypos_ext_GUESS,Y
        LDX     explosion_particle_count
        JSR     rnd

        AND     #$03
        CLC
        ADC     explosion_param_1
        AND     #$1F
        TAX
        LDA     angle_to_X_low,X
        STA     L0076
        LDA     angle_to_X_high,X
        STA     L0077
        LDA     angle_to_Y_low,X
        STA     L0078
        LDA     angle_to_Y_high,X
        STA     L0079
        LDA     L0077
        ROL     A
        PHP
        PHP
        PHP
        PHP
        LDX     #$04
	.L249A
        PLP
        ROR     L0077
        ROR     L0076
        DEX
        BNE     L249A

        LDA     L0079
        ROL     A
        PHP
        PHP
        PHP
        PHP
        LDX     #$04
	.L24AB
        PLP
        ROR     L0079
        ROR     L0078
        DEX
        BNE     L24AB

        LDA     #$00
        STA     particles_dx_low,Y
        STA     particles_dx_high,Y
        STA     particles_dy_low,Y
        STA     particles_dy_high,Y
        LDA     rnd_B
        AND     #$03
        TAX
        INX
        INX
        PHA
	.L24C9
        CLC
        LDA     L0076
        ADC     particles_dx_low,Y
        STA     particles_dx_low,Y
        LDA     L0077
        ADC     particles_dx_high,Y
        STA     particles_dx_high,Y
        CLC
        LDA     L0078
        ADC     particles_dy_low,Y
        STA     particles_dy_low,Y
        LDA     L0079
        ADC     particles_dy_high,Y
        STA     particles_dy_high,Y
        DEX
        BNE     L24C9

        PLA
        ROL     A
        ROL     A
        ROL     A
        EOR     #$1F
        STA     L0076
        LDA     particles_lifetime,Y
        ROL     A
        LDA     rnd_A
        AND     #$0F
        ROR     A
        ADC     L0076
        ADC     #$08
        STA     particles_lifetime,Y
        LDA     explosion_particle_type
        STA     particles_type,Y
        CLC
        LDA     explosion_param_1
        ADC     #$04
        AND     #$1F
        STA     explosion_param_1
        TYA
        TAX

        JSR     particle_move_index_X
        JSR     particle_move_index_X

        LDX     explosion_particle_count
        DEX
        BEQ     L2524

        JMP     loop

	.L2524
        RTS
}

.particle_return_free_slot_in_Y
{
        LDY     #PARTICLE_table_max

	.L2527
        LDA     particles_lifetime,Y
        AND     #($FF EOR PARTICLE_flag)
        BEQ     return

        DEY
        BNE     L2527

        LDY     #PARTICLE_table_max
	.L2533
        LDA     particles_lifetime,Y
        AND     #($FF EOR PARTICLE_flag)
        CMP     #$0A
        BCC     return

        DEY
        BNE     L2533

	.L253F
        BEQ     return
        BNE     L253F

        JSR     rnd
        AND     #$0F
        ADC     #$04
        TAY

	.return
        RTS
}

