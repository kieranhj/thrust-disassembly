        JMP     plot_char

.add_score_return
        RTS

.add_A_to_score
        LDX     demo_mode_flag
        BNE     add_score_return

        PHA
        LDA     score_B
        AND     #$F0
        STA     L0080
        PLA
        SED
        CLC
        ADC     score_A
        STA     score_A
        LDA     #$00
        ADC     score_B
        STA     score_B
        LDA     #$00
        ADC     score_C
        STA     score_C
        CLD
        LDA     score_B
        AND     #$F0
        CMP     L0080
        BEQ     show_lives

        JSR     extra_life

        JSR     countdown_sound

