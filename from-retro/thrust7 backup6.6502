.ship_logic_fn_A
        LDA     #$00
        STA     L007B
        LDA     #$49
        CLC
        ADC     L0CFB
        STA     ypos_var_D_HI_GUESS
        LDA     #$02
        STA     player_var_F
        LDA     #$41
        STA     general_ptr_A_LO
        LDX     xpos_var_A_HI_GUESS
        DEX
        STX     L0BA1
        STX     L0B63
        CLC
.L0B5D
        LDY     ypos_var_D_HI_GUESS
        LDA     L0400,Y
.L0B62
        SBC     #$00
        L0B63   = L0B62+1
        BCS     L0B6B

        LDA     #$00
        JMP     L0B71

.L0B6B
        CMP     #$48
        BCC     L0B71

        LDA     #$48
.L0B71
        STA     general_ptr_A_HI
        LDY     L007B
        SEC
        SBC     L0300,Y
        BCS     L0B88

        EOR     #$FF
        TAX
        INX
        LDA     general_ptr_A_HI
        STA     L0300,Y
        TAY
        JMP     L0B98

.L0B88
        CLC
        BEQ     L0B9B

        TAX
        LDA     L0300,Y
        STA     xpos_var_D_HI_GUESS
        LDA     general_ptr_A_HI
        STA     L0300,Y
        LDY     xpos_var_D_HI_GUESS
.L0B98
        JSR     L0D31

.L0B9B
        LDY     ypos_var_D_HI_GUESS
        LDA     L0500,Y
.L0BA0
        SBC     #$00
        L0BA1   = L0BA0+1
        BCS     L0BA9

        LDA     #$00
        JMP     L0BAF

.L0BA9
        CMP     #$48
        BCC     L0BAF

        LDA     #$48
.L0BAF
        STA     L0079
        LDY     L007B
        SEC
        SBC     L036F,Y
        BCS     L0BC6

        EOR     #$FF
        TAX
        INX
        LDA     L0079
        STA     L036F,Y
        TAY
        JMP     L0BD6

.L0BC6
        CLC
        BEQ     L0BD9

        TAX
        LDA     L036F,Y
        STA     xpos_var_D_HI_GUESS
        LDA     L0079
        STA     L036F,Y
        LDY     xpos_var_D_HI_GUESS
.L0BD6
        JSR     L0D31

.L0BD9
        INC     ypos_var_D_HI_GUESS
        INC     L007B
.L0BDD
        LDA     player_var_F
        ADC     #$02
        STA     player_var_F
        AND     #$07
        BEQ     L0BEA

        JMP     L0B5D

.L0BEA
        LDA     player_var_F
        ADC     #$38
        STA     player_var_F
        LDA     general_ptr_A_LO
        ADC     #$02
        STA     general_ptr_A_LO
        BMI     L0BFB

        JMP     L0B5D

.L0BFB
        RTS

.object_var_init_GUESS
