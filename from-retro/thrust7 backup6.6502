.add_A_X_to_fuel						; add A to fuel_A, add X to fuel_B & fuel_C
        SED
        CLC
        ADC     fuel_A
        STA     fuel_A
        TXA
        ADC     fuel_B
        STA     fuel_B
        TXA
        ADC     fuel_C
        STA     fuel_C
        CLD
        ORA     fuel_B
        ORA     fuel_A
        BEQ     L1A3F

        LDA     #$00
        STA     fuel_variable
.fuel_return
        RTS

.plot_fuel_GUESS
        LDA     fuel_variable
        BNE     fuel_return

        LDA     fuel_flag
        BMI     fuel_return

        LDA     #$DF
        STA     L0080
        LDA     #$1A
        STA     L0081
        LDA     #$0F
        STA     fuel_variable
        LDX     #$D1
