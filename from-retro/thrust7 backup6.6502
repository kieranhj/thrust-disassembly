		EQUB	LO(level_5_gun_param), HI(level_5_gun_param)

.ship_input_fire
        LDA     L0044
        BPL     fire_return

        LDA     shield_tractor_pressed
        BEQ     test_fire_key

        LDA     #$FF
        STA     player_pressed_fire

.fire_return
        RTS

.test_fire_key
        LDX     #INKEY_return
        JSR     test_inkey

        CPX     #$FF
        BEQ     fire_pressed

        LDA     #$00
        STA     player_pressed_fire
        RTS

.fire_pressed
        LDA     player_pressed_fire
        BEQ     player_shoot_bullet		; don't shoot another bullet if fire button already pressed
        RTS

.player_shoot_bullet
        LDX     bullet_index		; guess this is number bullets active (or some sort of bullet stack)
        LDA     bullet_table_index,X					; guess we're checking whether there is a free bullet slot
        CMP     #$00
        BNE     create_new_player_bullet					; don't fire unless not equal to 0

        LDA     bullet_table_var,X					; ditto checking whether there's a free bullet slot
        BEQ     create_new_player_bullet					; don't fire unless equal to 0

        RTS

.angle_to_bullet_dx_dy
        LDA     angle_to_X_low,Y		; guess this converts the rotation angle to X,Y (LO,HI)
        STA     bullet_table_dx_low,X	; guess these are bullet direction X,Y (LO,HI)
        LDA     angle_to_X_high,Y
        STA     bullet_table_dx_high,X
        LDA     angle_to_Y_low,Y
        STA     bullet_table_dy_low,X
        LDA     angle_to_Y_high,Y
        STA     bullet_table_dy_high,X
        RTS

.create_new_player_bullet
        LDA     #$FF
        STA     player_pressed_fire

        LDA     player_x_pos_low_GUESS
        STA     bullet_table_xpos_low,X
        LDA     player_x_pos_high_GUESS
        CLC
        ADC     #$04					; player x position offset by $4 - start bullet in centre?
        STA     bullet_table_xpos_high,X
        LDA     player_y_pos_low_GUESS
        STA     bullet_table_ypos_low,X
        CLC
        LDA     player_y_pos_high_GUESS
        ADC     #$05					; player y position offset by $5 - start bullet in centre?
        STA     bullet_table_ypos_high,X
        LDA     player_y_pos_ext_GUESS
        ADC     #$00
        STA     bullet_table_ypos_ext_GUESS,X
		
        LDY     ship_angle
        JSR     angle_to_bullet_dx_dy

        LDY     #$02
.move_bullet_initial
        CLC
        LDA     bullet_table_xpos_low,X
        ADC     bullet_table_dx_low,X
        STA     bullet_table_xpos_low,X
        LDA     bullet_table_xpos_high,X
        ADC     bullet_table_dx_high,X
        STA     bullet_table_xpos_high,X
        CLC
        LDA     bullet_table_ypos_low,X
        ADC     bullet_table_dy_low,X
        STA     bullet_table_ypos_low,X
        LDA     bullet_table_ypos_high,X
        ADC     bullet_table_dy_high,X
        STA     bullet_table_ypos_high,X
        PHP
        LDA     bullet_table_dy_high,X
        BMI     bullet_dy_negative

        LDA     #$00
        JMP     bullet_dy_positive

.bullet_dy_negative
        LDA     #$FF
		
.bullet_dy_positive
        PLP
        ADC     bullet_table_ypos_ext_GUESS,X
        STA     bullet_table_ypos_ext_GUESS,X
        DEY
        BNE     move_bullet_initial

        CLC
        LDA     bullet_table_dx_low,X
        ADC     player_velocity_x_low_GUESS
        STA     bullet_table_dx_low,X
        LDA     bullet_table_dx_high,X
        ADC     player_velocity_x_high_GUESS
        STA     bullet_table_dx_high,X
        CLC
        LDA     bullet_table_dy_low,X
        ADC     player_velocity_y_low_GUESS
        STA     bullet_table_dy_low,X
        LDA     bullet_table_dy_high,X
        ADC     player_velocity_y_high_GUESS
        STA     bullet_table_dy_high,X

        LDA     bullet_table_var,X
        AND     #$80
        ORA     #$28
        STA     bullet_table_var,X

        LDA     #$00
        STA     bullet_table_index,X

        INX
        TXA
        AND     #$03					; can only have 4 active bullets
        TAX
        STX     bullet_index
        JSR     own_gun_sound

        RTS

\\ Appears to be unreachable code?
		
        LDA     #$28
        STA     bullet_table_xpos_low,X
        STA     bullet_table_xpos_high,X
        LDA     #$02
        STA     bullet_table_ypos_low,X
        STA     bullet_table_ypos_high,X
        STA     bullet_table_ypos_ext_GUESS,X
        LDA     #$01
        STA     bullet_table_dx_low,X
        STA     bullet_table_dx_high,X
        STA     bullet_table_dy_low,X
        STA     bullet_table_dy_high,X
        LDA     #$28
        STA     bullet_table_var,X
        LDA     #$00
        STA     bullet_table_index,X
        RTS

