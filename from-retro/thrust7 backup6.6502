        EQUB    $08,$03,$06,$0C,$08,$00,$00,$00

.L4691									; this looks like original relocation code
        EQUB    $00,$AD,$02,$02,$85,$80,$AD,$03
        EQUB    $02,$85,$81,$A9,$9B,$8D,$02,$02
        EQUB    $A9,$56,$8D,$03,$02,$AD,$0B,$02
