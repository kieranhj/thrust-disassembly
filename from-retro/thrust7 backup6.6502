        EQUB    $85,$71,$AC,$B6,$FF,$B1,$70,$99
        EQUB    $00,$02,$88,$D0,$F8,$58,$A9,$EA
        EQUB    $A2,$00,$A0,$00,$20,$F4,$FF,$A9
        EQUB    $8C,$A2,$0C,$A0,$00,$20,$F4,$FF
        EQUB    $A9,$C8,$A2,$03,$A0,$00,$20,$F4
        EQUB    $FF,$A9,$04,$A2,$01,$20,$F4,$FF
        EQUB    $A9,$E1,$A2,$00,$A0,$00,$20,$F4
        EQUB    $FF,$A5,$80,$8D,$02,$02,$A5,$81
        EQUB    $8D,$03,$02,$A9,$01,$85,$70,$A9
