        LDA     L0042
        BMI     L3918

        LDA     mission_complete_flag_GUESS
        BNE     L394E

.L38F0
        LDA     L0042
        BPL     L38FF

        LDA     mission_complete_flag_GUESS
        BEQ     L38FF

        LDA     #$01
        STA     L0045
        JMP     L3907

.L38FF
        LDA     L0044
        BPL     L3907

        LDA     #$00
        STA     L0045
.L3907
