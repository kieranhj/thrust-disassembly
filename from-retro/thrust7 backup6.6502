.test_for_pause
		LDX		#INKEY_copy
		JSR		test_inkey
        BNE     not_paused

        LDA     shield_tractor_pressed
        BNE     not_paused

.pause_loop
        LDA     #$01
        STA     level_var_E

        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE					; *FX 15 - flush all buffers

        JSR     OSRDCH					; read character from input stream

        CMP     #ASCII_delete			; unpause key
        BNE     pause_loop

        JSR     reset_system_clock

        LDA     #$00
        STA     level_var_E

.not_paused
        LDX     #INKEY_Q				; quiet key
        JSR     test_inkey

        BNE     q_not_pressed
        STX     mute_sound_flag

.q_not_pressed
        LDX     #INKEY_S				; sound key
        JSR     test_inkey

        BNE     s_not_pressed

        LDA     #$00
        STA     mute_sound_flag

.s_not_pressed
        RTS

