        STA     L005E
        LDA     ypos_var_B_EXT_GUESS
        SBC     #$00
        STA     L005F
        LDA     ypos_var_C_HI_GUESS
        BPL     L3998

        INC     L005F
.L3998
        CLC
        LDA     L005E
