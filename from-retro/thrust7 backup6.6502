.system_clock_fn
        LDA     #$00
        STA     system_clock_MSB

.system_clock_fn_loop
        LDA     irq1_timer1_signal
        BEQ     skip_set_system_clock_MSB

        LDA     system_clock_MSB
        BNE     skip_set_system_clock_MSB

        JSR     L3A8E

        LDA     #$FF
        STA     system_clock_MSB
		
.skip_set_system_clock_MSB
        LDY     #HI(system_clock_value)
        LDX     #LO(system_clock_value)
        LDA     #$01
        JSR     OSWORD					; read system clock

        LDA     system_clock_value
        CMP     #$03
        BCC     system_clock_fn_loop

        LDA     #$00
		STA     system_clock_value
		
        LDY     #HI(system_clock_value)
        LDX     #LO(system_clock_value)
        LDA     #$02
        JSR     OSWORD					; write system clock

        LDA     system_clock_MSB
        BNE     L3A7F

        JSR     L3A8E

.L3A7F
        RTS

.reset_system_clock
        LDA     #$00
        STA     system_clock_value
		
        LDY     #HI(system_clock_value)
        LDX     #LO(system_clock_value)
        LDA     #$02
        JMP     OSWORD					; write system clock

.L3A8E
        JSR     L31B2

        JSR     L1D57

        JMP     L3168

.system_clock_value
        EQUB    $00,$00,$00,$00,$00		; LSB to MSB (5 bytes)

.system_clock_MSB
        EQUB    $00

		EQUB	$00

.test_inkey
        PHP
        CPX     #$8F
        BEQ     L3AA7

        LDA     demo_mode_flag
        BNE     L3ACB

.L3AA7
        TXA
        EOR     #$FF
        LDX     #$03
        LDY     #$0B
        SEI
        STX     SHEILA_System_VIA_Register_B
        LDX     #$7F
        STX     SHEILA_System_VIA_Data_Dir
        STA     SHEILA_System_VIA_Register_A_NH
        LDA     SHEILA_System_VIA_Register_A_NH
        STY     SHEILA_System_VIA_Register_B
        PLP
        LDX     #$00
        ROL     A
        BCC     L3AC8

        LDX     #$FF
.L3AC8
        CPX     #$FF
        RTS

.L3ACB
        PLP
        TXA
        LDX     #$04
.L3ACF
        CMP     L3AE8,X
        BEQ     L3ADA

        DEX
        BPL     L3ACF

        INX
        BEQ     L3AE5

.L3ADA
        LDA     L3AED,X
        LDX     #$00
        AND     count_and_lookup_value
        BEQ     L3AE5

        DEX
.L3AE5
        CPX     #$FF
        RTS
	
.L3AE8
        EQUB    $BF,$FE,$B6,$FF,$9D
.L3AED
		EQUB	$01,$02,$04,$08,$10

.count_and_lookup_value
        EQUB    $00

.count_and_lookup_outer
        EQUB    $00

.count_and_lookup_index
        EQUB    $00

.count_and_lookup_fn
        LDA     demo_mode_flag
        BEQ     count_and_lookup_return

        DEC     count_and_lookup_outer
        BMI     count_and_lookup_next_index

.count_and_lookup_return
        RTS

.count_and_lookup_next_index
        LDX     count_and_lookup_index
        LDA     count_and_lookup_value_table,X
        STA     count_and_lookup_value
        LDA     count_and_lookup_outer_table,X
        STA     count_and_lookup_outer
        INC     count_and_lookup_index
        RTS

.count_and_lookup_value_table
        EQUB    $00,$02,$00,$04,$01,$10,$18,$00
        EQUB    $01,$00,$18,$08,$0A,$08,$0A,$08
        EQUB    $0A,$08

.count_and_lookup_outer_table
        EQUB    $18,$0F,$05,$05,$08,$14,$17,$0F

.level_var_random_A
        EQUB    $08,$0D,$26,$0D

.level_var_random_B
        EQUB    $06

.level_var_random_C
        EQUB    $7F,$14,$0A,$0F,$7F

.mission_complete_copy_GUESS
		EQUB	$00

.enter_new_high_score_name
        LDA     #$09
        STA     high_score_counter
        LDA     #$01
        STA     high_score_ptr_A+1
        STA     high_score_ptr_B+1
        LDA     #$80
        STA     high_score_ptr_A
        LDA     #$70
        STA     high_score_ptr_B
.L3B49
        LDY     #$02
.L3B4B
        LDA     (high_score_ptr_A),Y
        CMP     (high_score_ptr_B),Y
        BCC     L3B56

        BNE     L3B5D

        DEY
        BPL     L3B4B

.L3B56
        LDA     high_score_ptr_A
        CMP     #$80
        BNE     L3B7A

        RTS

.L3B5D
        DEC     high_score_counter
        LDY     #$00
.L3B61
        LDA     (high_score_ptr_A),Y
        PHA
        LDA     (high_score_ptr_B),Y
        STA     (high_score_ptr_A),Y
        PLA
        STA     (high_score_ptr_B),Y
        INY
        CPY     #$10
        BNE     L3B61

        LDA     high_score_ptr_B
        STA     high_score_ptr_A
        SBC     #$10
        STA     high_score_ptr_B
        BCS     L3B49

.L3B7A
        CLC
        LDA     high_score_ptr_A
        ADC     #$06
        STA     read_line_parameter_block
        STA     L0085
        LDA     high_score_ptr_A+1
        STA     read_line_parameter_block+1
        STA     gun_param_B
        JSR     clear_screen_and_init

        JSR     plot_high_score_table

        JSR     L1AEA

        JSR     L1AED

        LDX     #$30
        LDY     #$4B
        JSR     set_text_coords

        LDY     high_score_counter
.L3BA0
        LDX     #$48
.L3BA2
        JSR     L15C2

        DEX
        BNE     L3BA2

        DEY
        BNE     L3BA0

        LDA     #$FF
        STA     L16AB
        LDA     #$00
        JSR     plot_char

        LDA     #$0F
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX 15 - flush all buffers

        LDA     #$F0
        STA     char_value

        LDA     #$00
        LDX     #LO(read_line_parameter_block)
        LDY     #HI(read_line_parameter_block)
        JSR     OSWORD					; read line from input stream

        BCC     L3BD5

        LDA     #$7E
        JSR     OSBYTE

        LDY     #$00
.L3BD5
        LDA     #$20
        STA     (L0085),Y
        INY
        CPY     #$0A
        BNE     L3BD5

        LDA     #$0F
        STA     char_value
        LDA     #$00
        STA     L16AB
        RTS

.read_line_parameter_block				; for OSWORD 0
        EQUB    $00						; buffer address for input LSB
		EQUB	$00						; buffer address for input MSB
		EQUB	$09						; maximum line length
		EQUB	$20						; min acceptable character value
        EQUB    $FF						; max acceptable character value

.main_wrchv
		JMP		plot_char
		RTS
		
.jmp_wrchv
        JMP     LFFFF					; address gets written into code in main_entry

        old_wrchv   = jmp_wrchv+1
        L3BF4   = jmp_wrchv+2

.print_decimal
        PHA
        ROR     A
        ROR     A
        ROR     A
        ROR     A
        AND     #$0F
        BEQ     L3C04

        CLC
        ADC     #$30
        JSR     plot_char

.L3C04
        PLA
        AND     #$0F
        CLC
        ADC     #$30
        JMP     plot_char

.mission_complete
        LDA     #$00
        STA     level_modifier_flag
        JSR     clear_screen_and_init

        JSR     write_mission

        LDX     #$50
        LDY     #$56
        JSR     set_text_coords

        LDA     mission_number
        JSR     print_decimal

        LDA     #$20
        JSR     plot_char

        JSR     write_complete

        SED
        CLC
        CLD
        LDA     #$00
        STA     L3C74
        LDA     level_number
        CLC
        ADC     #$05
        LDY     planet_countdown_timer
        BMI     L3C47

        PHA
        JSR     write_planet_destroyed

        PLA
        CLC
        ADC     #$05
.L3C47
        TAY
.L3C48
        TYA
        PHA
        LDA     #$40
        JSR     add_A_to_score

        LDA     L3C74
        SED
        ADC     #$04
        STA     L3C74
        CLD
        PLA
        TAY
        DEY
        BNE     L3C48

        JSR     write_bonus

        LDA     L3C74
        JSR     print_decimal

        LDA     #$30
        JSR     plot_char

        JSR     plot_char

        LDY     #$64
        JMP     wait_time_out

.L3C74
        EQUB    $00

.mission_number
        EQUB    $00						; BCD starting at 1

.level_modifier_flag
        EQUB    $00,$1E

.L3C78
        EQUB    $A5,$7E,$C9,$02,$90,$18,$C9,$07

\ ******************************************************************************
\ ******************************************************************************

.main_entry
        LDX     #$FF
        TXS								; reset stack
        LDX     #$A7
.zp_loop
        LDA     #$00
        STA     xpos_var_A_HI_GUESS,X
        DEX
        BNE     zp_loop					; reset first $A7 entries of zero page to 0

        LDY     #$4F					; size of multiplication table array (80)
        LDX     #$00
        LDA     #$00					; index into multiplication table arrays
        STA     value_low
        STA     value_high
.mult_by_8_loop							; create multiplication table N * 8 for 0 <= N <= $4F (79)
        LDA     value_low
        STA     mult_by_8_table_low,X	; store low byte at $9C0
        LDA     value_high
        STA     mult_by_8_table_high,X	; store high byte at $A10
        CLC
        LDA     value_low
        ADC     #$08
        STA     value_low
        LDA     value_high
        ADC     #$00
        STA     value_high				; add 8 to 16-bit number stored at $70
        INX
        DEY
        BPL     mult_by_8_loop			; loop 80 times

        LDA     WRCHV
        STA     old_wrchv
        LDA     WRCHV+1
        STA     old_wrchv+1				; store old WRCHV directly in code at jmp_wrchv
        LDA     #LO(main_wrchv)
        STA     WRCHV
        LDA     #HI(main_wrchv)
        STA     WRCHV+1					; redirect WRCHV to main_wrchv
		
\\ Copy OSWORD 7 (sound) parameters to $0700 (language space)
		
        LDX     #$00
.store_8_bytes_loop
        LDA     stored_at_07C8,X		
        STA     L07C8,X					; store 8 bytes at $07C8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07D0,X
        STA     L07D0,X					; store 8 bytes at $07D0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07D8,X
        STA     L07D8,X					; store 8 bytes at $07D8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07E0,X
        STA     L07E0,X					; store 8 bytes at $07E0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07E8,X
        STA     L07E8,X					; store 8 bytes at $07E8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07F0,X
        STA     L07F0,X					; store 8 bytes at $07F0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07F8,X
        STA     L07F8,X					; store 8 bytes at $07F8 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_07C0,X
        STA     L07C0,X					; store 8 bytes at $07C0 **NEED TO FIND OUT WHAT'S HERE**
        LDA     stored_at_0192,X
        STA     L0192,X					; store 8 bytes at $0192 **NEED TO FIND OUT WHAT'S HERE**
        INX
        CPX     #$08
        BNE     store_8_bytes_loop		; loop 8 times

\\ Store ballistics tables
		
        LDX     #$1F
.store_32_bytes_loop
        LDA     lookup_angle_to_y_low,X
        STA     angle_to_Y_low,X
        LDA     lookup_angle_to_y_high,X
        STA     angle_to_Y_high,X
        LDA     lookup_angle_to_x_low,X
        STA     angle_to_X_low,X
        LDA     lookup_angle_to_x_high,X
        STA     angle_to_X_high,X
        DEX
        BPL     store_32_bytes_loop		; loop 32 times

\\ Relocate game entry code to $0400
		
        LDA     #LO(game_entry_relocated)
        STA     relocate_src_ptr
        LDA     #HI(game_entry_relocated)
        STA     relocate_src_ptr+1				; relocate_src_ptr = $3DB3
        LDA     #LO(game_entry)
        STA     relocate_dest_ptr
        LDA     #HI(game_entry)
        STA     relocate_dest_ptr+1				; relocate_dest_ptr = $0400
        LDY     #$00
        LDX     #$03					; copy 3 pages
.relocate_0400_loop
        LDA     (relocate_src_ptr),Y
        STA     (relocate_dest_ptr),Y
        INY
        BNE     relocate_0400_loop

        INC     relocate_src_ptr+1
        INC     relocate_dest_ptr+1
        DEX
        BNE     relocate_0400_loop		; copy 3 pages from $3DB3 to $0400

        LDA     #$08
        LDX     #$62
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E62

        LDA     #$08
        LDX     #$70
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E70

        LDA     #$08
        LDX     #$7D
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E7D

        LDA     #$08
        LDX     #$8B
        LDY     #$3E
        JSR     OSWORD					; ENVELOPE at $3E8B

        LDX     #$00
.store_at_0100_loop
        LDA     high_score_table_relocated,X
        STA     high_score_table,X
        INX
        BPL     store_at_0100_loop		; store 128 bytes at $0100

        LDX     #$7D					; 126 bytes
.store_at_0900_loop
        LDA     in_game_messages_relocated,X
        STA     in_game_messages,X
        DEX
        BPL     store_at_0900_loop

        LDA     #$04
        STA     game_var_A

        LDA     #LO(mode_7_instructions)
        STA     relocate_src_ptr
        LDA     #HI(mode_7_instructions)
        STA     relocate_src_ptr+1				; set relocate_src_ptr to mode_7_instructions

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait for vsync

        LDY     #$00
.write_chars_loop
        LDA     (relocate_src_ptr),Y
        CMP     #$FF					; stop when hitting $FF
        BEQ     wait_for_spacebar

        JSR     jmp_wrchv				; write char

        INY
        BNE     write_chars_loop

        INC     relocate_src_ptr+1
        JMP     write_chars_loop		; write chars until reach $FF

.wait_for_spacebar
        LDA     #$0F
        LDX     #$00
        JSR     OSBYTE					; *FX 15,0 - flush all buffers

        JSR     OSRDCH					; wait for keypress

        CMP     #ASCII_space			; 32 = space bar
        BNE     wait_for_spacebar		; wait until spacebar is pressed

        JMP     game_entry				; jump to game start at $0400

.game_entry_relocated					; actually executes at $0400 after relocation
        LDA     #LO(status_bar_bytes)
        STA     relocate_src_ptr
        LDA     #HI(status_bar_bytes)
        STA     relocate_src_ptr+1
        LDA     #LO($3C80)
        STA     relocate_dest_ptr	
        LDA     #HI($3C80)
        STA     relocate_dest_ptr+1

\\ No longer need main_entry code so can overwrite it
\\ This is copying 2 character rows of MODE 1 (status bar at top of screen)
\\ Can't see it because we're not in right mode yet
		
        LDY     #$00
        LDX     #$05					; copy 5 pages (1280 bytes) from $4212 over $3C80 (main_entry)
.copy_5_pages_loop
        LDA     (relocate_src_ptr),Y
        STA     (relocate_dest_ptr),Y
        INY
        BNE     copy_5_pages_loop

        INC     relocate_src_ptr+1
        INC     relocate_dest_ptr+1
        DEX
        BNE     copy_5_pages_loop

        JSR     clear_screen_and_init

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait vsync

        LDA     #$90
        JSR     OSBYTE					; *FX $90 - *TV - obtain interlace status

        TYA
        EOR     #$01					; invert interlace status
        AND     #$01					; keep only that bit
        STA     L04A8					; store at $04A8
        LDA     #$90
        JSR     OSBYTE					; *FX $90 - *TV

        LDA     #$13
        JSR     OSBYTE					; *FX 19 - wait for vsync

        LDX     #$0D					; write R13-R0 to 6845
.set_crtc_reg_loop
        STX     SHEILA_6845_Register	; store register number
        LDA     crtc_regs,X				; load crtc registers
        STA     SHEILA_6845_Value		; store register value
        DEX
        BPL     set_crtc_reg_loop					;

        LDA     #$9A
        LDX     #$D8
        LDY     #$00
        JSR     OSBYTE					; *FX 154,216

        LDA     #$D8
        STA     SHEILA_Video_ULA		; write $D8 to R0 of ULA - **WHAT DOES THIS DO?**

        LDA     IRQ1V
        STA     old_irq1v
        LDA     IRQ1V+1
        STA     old_irq1v+1				; store IRQ1V

        SEI								; disable interrupts
        LDA     #LO(irq1_handler)
        STA     IRQ1V
        LDA     #HI(irq1_handler)
        STA     IRQ1V+1					; set IRQ1V to irq1_handler
        CLI								; enable interrupts

        LDA     #$18
        STA     SHEILA_System_VIA_Interrupt_Enable					; write $18 to system VIA - **WHY**
		
        LDX     #$00
.set_palette_loop
        LDA     palette_table,X			; load palette entry
        CMP     #$FF
        BEQ     done_set_palette_loop					; finish when reaching $FF

        STA     SHEILA_Palette					; store palette register
        INX
        BNE     set_palette_loop		; loop

.done_set_palette_loop
        JSR     clear_screen_and_init
        JMP     game_start

