.RELOC_START
        LDA     BRKV
        STA     old_brkv
        LDA     BRKV+1
        STA     old_brkv+1				; store current BRKV
        LDA     #LO(restore_brkv)
        STA     BRKV
        LDA     #HI(restore_brkv)
        STA     BRKV+1					; set BRKV to point at restore_brkv
        LDA     BYTEV+1
        BPL     eor_everything			; check OSBYTE vectored through OS otherwise bail out

        LDA     #$00
        LDX     #$FF
        LDY     #$FF
        JSR     OSBYTE					; *FX 0,255,255 - identify OS

        CPX     #$00
        BEQ     restore_brkv			; check for OS 1.00 / Electron

        SEI								; disable interrupts
        LDA     DEFVEC+1
        STA     readptr
        LDA     DEFVEC+2
        STA     readptr+1				; load default vector table
        LDY     DEFVEC					; presume size of vector table?
.userv_loop
        LDA     (readptr),Y
        STA     USERV,Y					; restore all default vectors
        DEY
        BNE     userv_loop

        CLI								; enable interrupts
        LDA     #$EA
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX &EA,0,0 - disable Tube

        LDA     #$8C
        LDX     #$0C
        LDY     #$00
        JSR     OSBYTE					; *FX &8C,0,0 - *TAPE 1200

        LDA     #$C8
        LDX     #$03
        LDY     #$00
        JSR     OSBYTE					; *FX &C8,3,0 - disable ESCAPE, memory cleared on BREAK

        LDA     #$04
        LDX     #$01
        JSR     OSBYTE					; *FX 4,1,0 - disable cursor editing, edit keys give ASCII codes

        LDA     #$E1
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX &E1,0,0 - ignore FN keys

.restore_brkv
        LDA     old_brkv
        STA     BRKV
        LDA     old_brkv+1
        STA     BRKV+1					; restore old BRKV
        LDA     #$00					; is $01 in original source as relocates from $1A01
        STA     readptr
        LDA     #$1A
        STA     readptr+1				; set readptr to &1A01
        LDA     #$60
        STA     writeptr
        LDA     #$0A
        STA     writeptr+1				; set writeptr to &0A60
        LDX     #$3D
.relocate
        LDY     #$00
.relocate_loop
        LDA     (readptr),Y
        STA     (writeptr),Y
        DEY
        BNE     relocate_loop

        INC     readptr+1
        INC     writeptr+1
        DEX
        BNE     relocate				; relocate &3D pages (~16k) from &1A01 to &0A60

        JMP     L3C80					; jump to entry

.eor_everything
        LDA     #$01
        STA     readptr
        LDA     #$1A
        STA     readptr+1
        LDX     #$3D
.eor_loop
        LDA     (readptr),Y
        EOR     (readptr+1),Y
        STA     (readptr),Y
        DEY
        BNE     eor_loop

        INC     readptr+1
        DEX
        BNE     eor_loop

        RTS

.BeebDisEndAddr
.RELOC_END

;SAVE "thrust6.bin",BeebDisStartAddr,BeebDisEndAddr
SAVE "Thrust6", START, RELOC_END, RELOC_START+OFFSET, RELOAD_ADDR
