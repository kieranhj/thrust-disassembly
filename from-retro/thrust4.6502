.L5632
        EQUB    $00

.L5633
        LDA     BRKV
        STA     old_brkv
        LDA     BRKV+1
        STA     old_brkv+1				; store current BRKV
        LDA     #LO(restore_brkv)
        STA     BRKV
        LDA     #HI(restore_brkv)
        STA     BRKV+1					; set BRKV to point at restore_brkv
        LDA     BYTEV+1
        BPL     eor_everything			; check OSBYTE vectored through OS otherwise bail out

        LDA     #$00
        LDX     #$FF
        LDY     #$FF
        JSR     OSBYTE					; *FX 0,255,255 - identify OS

        CPX     #$00
        BEQ     restore_brkv			; check for OS 1.00 / Electron

        SEI								; disable interrupts
        LDA     DEFVEC+1
        STA     readptr
        LDA     DEFVEC+2
        STA     readptr+1				; load default vector table
        LDY     DEFVEC					; presume size of vector table?
.userv_loop
        LDA     (readptr),Y
        STA     USERV,Y					; restore all default vectors
        DEY
        BNE     userv_loop

        CLI								; enable interrupts
        LDA     #$EA
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX &EA,0,0 - disable Tube

        LDA     #$8C
        LDX     #$0C
        LDY     #$00
        JSR     OSBYTE					; *FX &8C,0,0 - *TAPE 1200

        LDA     #$C8
        LDX     #$03
        LDY     #$00
        JSR     OSBYTE					; *FX &C8,3,0 - disable ESCAPE, memory cleared on BREAK

        LDA     #$04
        LDX     #$01
        JSR     OSBYTE					; *FX 4,1,0 - disable cursor editing, edit keys give ASCII codes

        LDA     #$E1
        LDX     #$00
        LDY     #$00
        JSR     OSBYTE					; *FX &E1,0,0 - ignore FN keys

.restore_brkv
        LDA     old_brkv
        STA     BRKV
        LDA     old_brkv+1
        STA     BRKV+1					; restore old BRKV
        LDA     #$01
        STA     readptr
        LDA     #$1A
        STA     readptr+1				; set readptr to &1A01
        LDA     #$60
        STA     writeptr
        LDA     #$0A
        STA     writeptr+1				; set writeptr to &0A60
        LDX     #$3D
.relocate
        LDY     #$00
.relocate_loop
        LDA     (readptr),Y
        STA     (writeptr),Y
        DEY
        BNE     relocate_loop

        INC     readptr+1
        INC     writeptr+1
        DEX
        BNE     relocate				; relocate &3D pages (~16k) from &1A01 to &0A60

        JMP     L3C80					; jump to entry

.eor_everything
        LDA     #$01
        STA     readptr
        LDA     #$1A
        STA     readptr+1
        LDX     #$3D
.eor_loop
        LDA     (readptr),Y
        EOR     (readptr+1),Y
        STA     (readptr),Y
        DEY
        BNE     eor_loop

        INC     readptr+1
        DEX
        BNE     eor_loop

        RTS

.L56E3
        JMP     L5633

        JMP     L56E3

.L56E9
        ADC     LFAD0,Y
        L56EA   = L56E9+1
        JSR     L575B

        LDA     (old_brkv),Y
        EOR     (L0082),Y
        CMP     L342F,Y
        BEQ     L570E

        JSR     L575B

        BCS     L570E

        LDA     BRKV
        STA     L570C
        LDA     BRKV+1
        STA     L570D
        JMP     L570E

.L570C
        SEI
.L570D
; PC=570D INVALID opcode B2
.L570E
        PLA
        STA     (L0082),Y
        INY
        BNE     L5718

        INC     old_brkv+1
        INC     L0083
.L5718
        EOR     (L0082),Y
        PHA
        ORA     #$01
        JMP     L56EA

        JSR     L575B

        LDX     #$00
.L5725
        LDA     L5732,X
        CMP     #$FF
        BEQ     L573F

        JSR     OSWRCH

        INX
        BNE     L5725

.L5732
        ASL     L0007,X
; PC=5734 INVALID opcode 17
        ORA     (L0000,X)
        BRK
.L5738
        EQUB    $00

        BRK
.L573A
        EQUB    $00

        BRK
.L573C
        EQUB    $00

        BRK
.L573E
        EQUB    $FF

.L573F
        LDA     #$00
        STA     old_brkv
        LDA     #$1A
        STA     old_brkv+1
        CLC
        LDA     old_brkv
        ADC     #$01
        STA     L0082
        LDA     old_brkv+1
        ADC     #$00
        STA     L0083
        LDY     #$00
        LDA     (old_brkv),Y
        JSR     L5718

.L575B
        LDA     (old_brkv),Y
        CMP     (L0082),Y
        BEQ     L576D

        EOR     #$FA
        STA     L570C
        INY
        LDA     (old_brkv),Y
        STA     L570D
        DEY
.L576D
        RTS

        BRK
.L576F
        EQUB    $00

.BeebDisEndAddr
